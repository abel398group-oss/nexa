{
  "$comment": "Tokens de design do HiperTMS para replicar no Nexa. Fonte: apps/web/src/styles/globals.css.",
  "colors": {
    "brand": {
      "50": "#fff3ed", "100": "#ffe2d1", "200": "#ffd0b3", "300": "#ffb089",
      "400": "#ff8a5c", "500": "#ff5a1f", "600": "#ed4708", "700": "#c23a0a",
      "800": "#9a2e08", "900": "#7a2406", "950": "#4d1604"
    },
    "primary": "#ff5a1f",
    "primaryDark": "#ed4708",
    "primaryLight": "#ffb089",
    "navy": { "DEFAULT": "#1e3a5f", "700": "#16304d" },
    "ink": { "900": "#0e0f13", "800": "#16181d", "700": "#1f222a", "600": "#23262e" },
    "base": {
      "light": { "100": "#fafaf9", "200": "#f2f2f0", "300": "#e6e6e3", "content": "#16181d" },
      "dark":  { "100": "#0e0f13", "200": "#16181d", "300": "#1f222a", "content": "#fafaf9" }
    },
    "sidebar": {
      "bg": "#16181d", "bgDark": "#0e0f13",
      "iconAccent": "#ff7a47", "iconAccentDark": "#ff8a5c",
      "text": "rgba(255,255,255,0.56)", "textHover": "rgba(255,255,255,0.93)", "textActive": "#f4f4f8",
      "border": "rgba(255,255,255,0.09)", "active": "rgba(255,255,255,0.13)", "hover": "rgba(255,255,255,0.07)"
    },
    "status": {
      "success": { "base": "#16a34a", "tint": "#dcfce7", "ink": "#166534", "tintDark": "rgba(22,163,74,0.22)", "inkDark": "#86efac" },
      "warning": { "base": "#f97316", "tint": "#fef3c7", "ink": "#92400e", "tintDark": "rgba(249,115,22,0.20)", "inkDark": "#fdba74" },
      "danger":  { "base": "#dc2626", "tint": "#fee2e2", "ink": "#991b1b", "tintDark": "rgba(220,38,38,0.20)", "inkDark": "#fca5a5" },
      "info":    { "base": "#0284c7", "tint": "#e0f2fe", "ink": "#075985", "tintDark": "rgba(2,132,199,0.22)", "inkDark": "#7dd3fc" },
      "neutral": { "tint": "#f2f2f0", "ink": "#44464d", "tintDark": "#1f222a", "inkDark": "#a1a1aa" }
    },
    "signatureGradient": "linear-gradient(135deg, #ff5a1f 0%, #ed4708 50%, #1e3a5f 100%)"
  },
  "typography": {
    "fontSans": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "fontHeading": "system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif",
    "fontMono": "'JetBrains Mono', ui-monospace, monospace",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "extrabold": 800 },
    "sizesPx": { "xs": 12, "sm": 14, "base": 15, "lg": 18, "xl": 20, "2xl": 24, "h1Marketing": 51 },
    "tracking": { "tight": "-0.02em", "eyebrow": "0.16em" },
    "lineHeight": 1.5,
    "numbers": "tabular-nums + mono",
    "uiZoom": 0.8
  },
  "spacing": {
    "base": "4px",
    "scalePx": [0, 2, 4, 6, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80],
    "layout": { "sidebar": "12.8rem", "sidebarCollapsed": "3.6rem", "topbar": "3.5rem", "contentMax": "1280px" }
  },
  "radius": { "md": "6px", "lg": "8px", "xl": "12px", "2xl": "16px", "3xl": "30px", "full": "9999px" },
  "shadow": {
    "card": "0 2px 8px -2px rgb(0 0 0 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.04)",
    "cardHover": "0 10px 25px -5px rgb(0 0 0 / 0.08), 0 8px 10px -6px rgb(0 0 0 / 0.04)",
    "elevated": "0 10px 40px -10px rgb(0 0 0 / 0.15), 0 4px 12px -4px rgb(0 0 0 / 0.08)",
    "innerSoft": "inset 0 2px 4px 0 rgb(0 0 0 / 0.04)",
    "up": "0 -2px 10px rgb(0 0 0 / 0.06)",
    "glowPrimary": "0 0 26px -4px rgb(255 90 31 / 0.30)",
    "glowDanger": "0 0 20px -4px rgb(220 38 38 / 0.30)",
    "glowSuccess": "0 0 20px -4px rgb(22 163 74 / 0.30)"
  },
  "motion": {
    "easeEntrance": "cubic-bezier(0.22, 1, 0.36, 1)",
    "easeLayout": "cubic-bezier(0.4, 0, 0.2, 1)",
    "durationEntrance": "320ms",
    "durationLayout": "200ms"
  },
  "darkMode": { "strategy": "class .dark on <html>" }
}
