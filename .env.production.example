# ============================================================
# .env.production.example - Nexa
# ============================================================
# COMO USAR (no droplet): cp .env.production.example .env && nano .env
# NUNCA commitar o .env real. "$" literal em valores -> escapar como "$$".
# Gerar segredos fortes: openssl rand -base64 48
# validateEnv() ABORTA o boot em producao se faltar uma var obrigatoria (marcadas 🔴).
# O frontend NAO usa vars de build (baseURL '/api' e relativo) - nada de VITE_ aqui.
# ============================================================

# ---- Geral / Runtime ----
NODE_ENV=production
PORT=3001
TZ=America/Sao_Paulo

# ---- Banco (PostgreSQL GERENCIADO - DigitalOcean) ---- 🔴 DATABASE_URL
# sslmode=require obrigatorio; usuario dedicado nexa_app (ver deploy-managed-postgres.md)
DATABASE_URL=postgresql://nexa_app:SENHA@HOST:25060/nexa?sslmode=require&schema=public&connection_limit=20&pool_timeout=10

# ---- Redis (container interno da nexa-network) ----
REDIS_URL=redis://:SENHA_REDIS@redis:6379
REDIS_PASSWORD=SENHA_REDIS

# ---- IA (Anthropic / Lia) ---- 🔴 ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=GERE_NO_PAINEL_ANTHROPIC
AI_MODEL=claude-haiku-4-5-20251001
AI_AUTONOMY_ENABLED=false            # kill switch default (ADR 012) - ligar com cautela
# AI_TIMEOUT_MS=20000                # timeout por chamada a Anthropic (C1) - evita request pendurado
# AI_MAX_RETRIES=1                   # retries para falhas transitorias (429/5xx/timeout)
# AI_RETRY_BASE_MS=500               # base do backoff exponencial entre retries
# AI_MAX_CONCURRENCY=8               # max chamadas simultaneas a Anthropic (pico -> fila FIFO)
# TRANSFORMERS_CACHE ja e definido no compose (/usr/src/app/.cache, com volume)
# EMBEDDINGS_ENABLED=true            # false desliga embeddings (cai na busca textual)
# EMBEDDING_MODEL=Xenova/multilingual-e5-small
# WHISPER_MODEL=Xenova/whisper-base

# ---- Manutencao / retencao (todos opcionais, com default seguro) ----
# PROCESSED_MSG_RETENTION_HOURS=48     # A2: expurgo do dedup de inbound (default 48h)
# SESSION_RETENTION_DAYS=30            # A2: expurgo de sessoes expiradas/revogadas (default 30d)
# DATA_RETENTION_DAYS=730              # LGPD: anonimizacao de dados pessoais (default 2 anos)

# ---- Seed (SO ao rodar pnpm db:seed em ambiente NOVO) ----
# SEED_ADMIN_PASSWORD=                 # M3: senha do admin inicial. OBRIGATORIA em producao
                                       #     ao rodar o seed. Producao existente NAO precisa reseed.

# ---- Auth (sessoes internas) ---- 🔴 JWT_SECRET, JWT_REFRESH_SECRET, PORTAL_JWT_SECRET
JWT_SECRET=GERE_FORTE_32+            # openssl rand -base64 48
JWT_REFRESH_SECRET=GERE_OUTRO_FORTE  # DIFERENTE do JWT_SECRET
PORTAL_JWT_SECRET=GERE_OUTRO_FORTE   # sessao do Portal (aud:portal) - isolado do interno

# ---- WhatsApp (WAHA - provisorio, sera trocado pela Cloud API) ---- 🔴 WAHA_WEBHOOK_TOKEN
WAHA_API_URL=http://waha:3000        # host interno da nexa-network (container waha)
WAHA_API_KEY=GERE_FORTE              # MESMA chave do container waha (header X-Api-Key)
WAHA_SESSION=default
WAHA_WEBHOOK_TOKEN=GERE_FORTE        # autentica os webhooks (/api/webhooks/waha?token=...)
WAHA_SENDER_PHONE=55XXXXXXXXXXX      # numero pareado (diagnostico)
WAHA_SEND_ALLOWLIST=                 # CSV de numeros liberados p/ envio (vazio = libera geral)
# WAHA_REACHABLE_BASE=               # base p/ reescrever URLs de midia, se necessario
# WHATSAPP_MEDIA_ENABLED=true
# WHATSAPP_INVITE_LINK=

# ---- Conector HiperTMS (read-only) ----
TMS_DB_URL=postgresql://LEITURA@HOST_TMS:25060/tms?sslmode=require   # SELECT-only - NUNCA migrar/escrever
TMS_API_BASE_URL=https://api.hipertms.SEU_DOMINIO
TMS_SERVICE_TOKEN=TOKEN_SERVER_TO_SERVER   # mesmo token configurado no TMS (handoff + conector)
TMS_TENANT_ID_HIPERTMS=UUID_DO_TENANT_HIPERTMS   # id da tabela SystemCoreTenant onde slug='t-56886635000192'

# ---- URLs publicas / CORS ----
NEXA_PUBLIC_URL=https://nexa.SEU_DOMINIO        # base publica (webhooks do WAHA, links)
NEXA_API_URL=https://nexa.SEU_DOMINIO/api       # base da API (integracoes)
NEXA_PORTAL_URL=https://nexa.SEU_DOMINIO/portal # entrada do Portal do cliente
CORS_ORIGINS=https://nexa.SEU_DOMINIO,https://app.hipertms.SEU_DOMINIO  # CSV de origens

# ---- Suporte humano (P2) ----
# E-mail que recebe aviso quando um chamado entra na fila humana
# (aberto pelo cliente no portal ou escalado pela Lia). Vazio = não envia.
SUPPORT_EMAIL=suporte@SEU_DOMINIO
