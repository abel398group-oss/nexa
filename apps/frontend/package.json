{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report e2e/.report",
    "test:e2e:visual": "playwright test visual-regression",
    "test:e2e:flows": "playwright test interactive-flows",
    "test:e2e:update-snapshots": "playwright test visual-regression --update-snapshots"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@sentry/react": "^8.0.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.7.0",
    "date-fns": "^4.1.0",
    "react": "^18.3.0",
    "react-day-picker": "^9.0.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.0",
    "recharts": "^3.8.0",
    "socket.io-client": "^4.8.0",
    "sonner": "^1.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/addon-themes": "^8.3.0",
    "@storybook/blocks": "^8.3.0",
    "@storybook/react": "^8.3.0",
    "@storybook/react-vite": "^8.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^30.0.1",
    "storybook": "^8.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
