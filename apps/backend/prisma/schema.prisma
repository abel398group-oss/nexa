// ============================================================================
// Nexa — Schema Prisma (Sprint 1 / Fase 1 core)
// Derivado de docs-leads/schema/schema.prisma. Só as tabelas da Fase 1.
// As demais (agentes, billing avançado, health, etc.) entram em migrations seguintes.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // NOTA (docs/infra/item1-pool-conexoes-2026-07.md): ao ativar o connection
  // pool do DO, ADICIONAR aqui `directUrl = env("DIRECT_DATABASE_URL")` E
  // definir a env no mesmo passo — declarar antes, com a env ausente, quebra
  // `prisma generate`/CI. Por isso fica como nota até a ativação.
}

// ===================== ENUMS =====================
enum SourceChannel {
  whatsapp
  telegram
  site
  instagram
  facebook
  email
  portal
  web_chat // ADR 027: chat embutido no HiperTMS (widget ao lado do chat interno)
}

enum AgentType {
  router
  sdr
  sales
  onboarding
  support
  billing
  knowledge
  analytics
}

enum CustomerStage {
  lead
  cliente_novo
  cliente_ativo
}

enum ConversationStatus {
  open
  waiting_customer   // aguardando resposta do lead
  waiting_internal   // aguardando ação interna (vendedor, suporte)
  escalated
  opt_out            // lead pediu descadastro — fecha imediatamente
  closed             // fechado por regra automática ou ação manual
}

enum MessageDirection {
  inbound
  outbound
}

enum ActionType {
  create_payment
  get_payment_status
  consult_plan
  escalate
  update_context
  cancel_payment
  refund
  cancel_subscription
  delete_customer
  alter_contract
}

enum ActionStatus {
  requested
  validated
  executed
  blocked
  failed
}

enum EventStatus {
  created
  queued
  processing
  processed
  failed
}

enum EventPriority {
  alta
  media
  baixa
}

enum DlqStatus {
  pending
  reprocessed
  discarded
}

// ===================== AUTH (Sprint 2) =====================
enum UserRole {
  admin
  gestor
  operacional
  financeiro
  vendedor
}

model User {
  id           String    @id @default(uuid())
  tenantId     String?   @map("tenant_id") // null = admin da plataforma
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         UserRole  @default(operacional)
  sellerId     String?   @map("seller_id") // se role=vendedor, vincula ao cadastro Seller
  permissions  String[]  @default([]) // áreas liberadas p/ não-admin (admin = tudo)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions Session[]
  // F12: chamados de suporte atribuídos a este analista (assignedAnalystId).
  assignedConversations AiConversation[]

  @@index([tenantId])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  revokedAt        DateTime? @map("revoked_at") // revogação de sessão
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String?  @map("tenant_id")
  userId        String?  @map("user_id")
  action        String
  resource      String?
  metadata      Json     @default("{}")
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@map("audit_logs")
}

// ===================== CONTATOS (Sprint 3) =====================
model Contact {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  phone             String
  name              String?
  nameSource        String?  @default("pushname") @map("name_source") // pushname | lead | tms | manual (ADR 020)
  company           String?
  // Frota informada pelo PRÓPRIO lead na conversa (2026-08-01, extração de
  // perfil). Aditivo e nullable — contato sem essa informação segue igual.
  fleetSize         Int?     @map("fleet_size")
  email             String?  // armazenar NULL quando ausente — NUNCA string vazia (ADR 021)
  source            String?  // origem do lead (consent_source — LGPD)
  status            String   @default("active") // active / opted_out
  leadStatus        String?  @map("lead_status") // new / cold / warm / hot
  interestScore     Int      @default(0) @map("interest_score")
  externalContactId String?  @map("external_contact_id") // ref no produto/TMS
  // F16 (2026-08-06, unificação Contatos+Inbox): dono da conta no CRM interno —
  // campo manual, não vem do TMS (não existe fonte automática pra isso hoje).
  // Editável direto no painel do Inbox, sem precisar da tela /contacts.
  accountOwner      String?  @map("account_owner")
  tags              String[]
  notes             String?
  optOutAt          DateTime? @map("opt_out_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, phone])
  @@unique([tenantId, email])  // NULL é OK — Postgres aceita múltiplos NULL em unique (ADR 021)
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, externalContactId])
  @@map("contacts")
}

// Registro de abuso por telefone — "3 strikes" (2026-08-04).
//
// Cada vez que shared/governance/output-guard.ts barra uma resposta da Lia
// (preço fora do catálogo, vazamento de prompt, ofensa, ou dado sensível de
// terceiro), é sinal de que quem está do outro lado tentou manipular a IA —
// não é erro da Lia, é ataque. Aqui a gente conta essas tentativas por
// telefone e, ao atingir o teto, bane: a Lia para de responder aquele
// número, silenciosamente (mesma lógica do wrong_person — responder
// confirma o número como ativo).
//
// Fica fora da tabela `contacts` de propósito: apagar/reimportar um contato
// (limpeza de base, por exemplo) não pode apagar o histórico de abuso junto
// — mesmo raciocínio do OptOutRecord.
model ContactAbuseRecord {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  phone         String
  strikeCount   Int       @default(0) @map("strike_count")
  lastViolation String?   @map("last_violation") // ex.: "preco_nao_autorizado", "vazamento_de_dados"
  lastDetail    String?   @map("last_detail")    // trecho legível — vai pro admin, nunca pro cliente
  lastAt        DateTime? @map("last_at")
  bannedAt      DateTime? @map("banned_at")       // null = ainda não banido
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, phone])
  @@index([tenantId, bannedAt])
  @@map("contact_abuse_records")
}

// ===================== FASE 1 — CORE =====================
model AiConversation {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  productCode   String?            @map("product_code")
  externalId    String?            @map("external_id") // cliente externo (TMS) — usado pelo portal
  correlationId String             @map("correlation_id")
  contactId     String             @map("contact_id")
  phone         String
  sourceChannel SourceChannel      @map("source_channel")
  agentType     AgentType          @map("agent_type")
  customerStage CustomerStage      @map("customer_stage")
  status        ConversationStatus @default(open)
  startedAt     DateTime           @default(now()) @map("started_at")
  endedAt       DateTime?          @map("ended_at")
  createdAt     DateTime           @default(now()) @map("created_at")

  assignedSellerId String?   @map("assigned_seller_id")
  assignedSeller   Seller?   @relation(fields: [assignedSellerId], references: [id])
  assignedAt       DateTime? @map("assigned_at")
  // F12 (2026-08-06, operação do time de suporte): dono humano do chamado —
  // não confundir com assignedSellerId (vendedor, lado comercial). Ver
  // docs/reviews/2026-08-06-auditoria-operacao-time-suporte.md, item 1.
  assignedAnalystId   String?   @map("assigned_analyst_id")
  assignedAnalyst     User?     @relation(fields: [assignedAnalystId], references: [id])
  assignedAnalystAt   DateTime? @map("assigned_analyst_at")
  // F13 (2026-08-06, Ciclo 2 — ponte com Dev/N3): link da issue externa
  // (Jira/GitHub/ClickUp/Trello) que este chamado depende pra ser resolvido.
  // Sem integração ativa — é o suporte colando o link manualmente. Ver
  // docs/reviews/2026-08-06-auditoria-operacao-time-suporte.md, item 6.
  linkedIssueUrl      String?   @map("linked_issue_url")
  lastActivityAt   DateTime? @map("last_activity_at") // atualizado a cada msg — base da regra de 7 dias
  outcome          String?   @map("outcome") // won | lost | no_response | opt_out | resolved
  outcomeAt        DateTime? @map("outcome_at")
  resolvedAt       DateTime? @map("resolved_at") // quando IA marcou como resolvido (suporte)
  autoCloseAt      DateTime? @map("auto_close_at") // timestamp p/ fechar automaticamente (resolvido+48h)
  ticketCategory   String?   @map("ticket_category") // fiscal | cte | mdfe | frete | financeiro | ...
  ticketPriority   String?   @map("ticket_priority") // critical | high | medium | low
  rootCause        String?   @map("root_cause") // causa-raiz classificada pelo DiagnosticAgent
  // §3 (auditoria de suporte, 2026-08-05): vetor semântico do rootCause, gravado sob
  // demanda pelo TicketIntelligenceService na primeira vez que o ticket é analisado —
  // permite achar recorrência mesmo quando a IA descreve a mesma causa com palavras
  // diferentes (mesmo padrão de storeEmbedding() em knowledge.service.ts).
  rootCauseEmbedding Unsupported("vector(384)")? @map("root_cause_embedding")
  followUpOfId     String?   @map("follow_up_of_id") // N1: id do chamado anterior que originou este follow-up
  csatScore        Int?      @map("csat_score")    // N2: nota de satisfação 1–5 enviada pelo cliente
  csatComment      String?   @map("csat_comment")  // N2: comentário opcional do CSAT
  csatToken        String?   @unique @map("csat_token") // N2: token único para endpoint público de CSAT (1x)
  ticketNumber     Int?      @map("ticket_number") // N3: número sequencial por tenant (gerado ao classificar)
  subject          String?   @map("subject")       // N3: assunto digitado pelo cliente (separado do rootCause da IA)
  slaAlertedAt     DateTime? @map("sla_alerted_at") // N4: timestamp do último alerta SLA (dedup persistente, substitui Map em memória)
  humanTakeoverAt  DateTime? @map("human_takeover_at") // ADR 035: humano assumiu — Lia em modo rascunho (limpo no fechamento/devolução)
  // F10 (2026-08-06): resumo executivo de 3 linhas gerado pelo EscalationAgent
  // no momento do transbordo — [Problema Relatado] / [Ações Tentadas] /
  // [Causa do Transbordo]. Gravado só quando escala (nulo em ticket resolvido
  // pela IA). Consumido pela notificação de escalonamento e pelo card do Inbox.
  escalationSummary String?  @map("escalation_summary")

  // F9 (sync de ticket com o TMS): estado de entrega do resumo pro endpoint
  // deles (POST /api/nexa/tickets, HMAC). Sem tabela de delivery separada —
  // cada ticket tem um destino só. Ver TicketSyncService.
  ticketSyncStatus      String?   @map("ticket_sync_status")      // pending | delivered | failed
  ticketSyncAttempts    Int       @default(0) @map("ticket_sync_attempts")
  ticketSyncNextRetryAt DateTime? @map("ticket_sync_next_retry_at")
  ticketSyncError       String?   @map("ticket_sync_error")

  messages      AiMessage[]
  actions       AiAction[]
  stageHistory  ConversationStageHistory[]
  followUpOf    AiConversation?  @relation("FollowUp", fields: [followUpOfId], references: [id], onDelete: SetNull)
  followUps     AiConversation[] @relation("FollowUp")

  @@index([tenantId])
  @@index([tenantId, contactId]) // F16: histórico de chamados por contato (painel do Inbox)
  @@index([correlationId])
  @@index([contactId])
  @@index([tenantId, externalId])
  @@index([status, lastActivityAt])
  @@index([ticketSyncStatus, ticketSyncNextRetryAt])
  @@map("ai_conversations")
}

// Histórico de mudanças de status e outcome — fonte para relatórios comerciais.
// Grava de→para sempre que status ou outcome muda (janitor, opt_out, won/lost, reabertura).
model ConversationStageHistory {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromStatus     String?   @map("from_status")
  toStatus       String    @map("to_status")
  fromOutcome    String?   @map("from_outcome")
  toOutcome      String?   @map("to_outcome")
  reason         String?   // inatividade_7d | opt_out | won | lost | reaberta | manual
  changedAt      DateTime  @default(now()) @map("changed_at")

  @@index([conversationId])
  @@index([changedAt])
  @@map("conversation_stage_history")
}

model AiMessage {
  id               String           @id @default(uuid())
  conversationId   String           @map("conversation_id")
  conversation     AiConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenantId         String           @map("tenant_id")
  correlationId    String           @map("correlation_id")
  direction        MessageDirection
  content          String
  metadata         Json             @default("{}")
  intent           String?
  promptVersion    String?          @map("prompt_version")
  kbVersion        String?          @map("kb_version")
  tokensIn         Int?             @map("tokens_in")
  tokensOut        Int?             @map("tokens_out")
  estimatedCostUsd Decimal?         @map("estimated_cost_usd") @db.Decimal(10, 6)
  actualCostUsd    Decimal?         @map("actual_cost_usd") @db.Decimal(10, 6)
  latencyMs        Int?             @map("latency_ms")
  externalId       String?          @map("external_id") // id da msg no WhatsApp (p/ casar recibos)
  // C3 (auditoria 2026-07-08): coluna dedicada em vez de filtrar metadata->>'campaignId'.
  // O filtro por JSON não usava índice (seq scan na maior tabela). Populada por
  // ConversationsService.addMessage a partir de metadata.campaignId.
  campaignId       String?          @map("campaign_id")
  ack              Int              @default(0) // 0 pend,1 enviado ✓,2 entregue ✓✓,3 lido ✓✓azul
  createdAt        DateTime         @default(now()) @map("created_at")
  // F12 (2026-08-06): nota interna — visível só pra equipe de suporte, NUNCA
  // despachada pro cliente (WAHA/widget/portal). Default false preserva todo
  // histórico existente. Ver ConversationsService.addMessage/getMessages e
  // ConversationsGateway.handleMessageCreated pros pontos que filtram isto.
  isInternal       Boolean          @default(false) @map("is_internal")
  // Etapa 2A (2026-08-07): autor humano da mensagem, gravado SEMPRE a partir do
  // JWT no servidor — nunca do body. É a base da regra "só o autor edita a
  // própria nota interna"; usar `metadata.authorUserId` não serviria, porque
  // metadata vem do cliente e seria forjável. Nullable: notas anteriores a esta
  // migration ficam sem autor e só admin pode editá-las.
  authorUserId     String?          @map("author_user_id")

  @@index([conversationId])
  @@index([correlationId])
  @@index([externalId])
  @@index([tenantId, intent]) // PERF-004: filtros de campanha e analytics
  @@index([campaignId]) // C3: engajamento/conversão por campanha sem full scan
  @@index([tenantId, direction, createdAt]) // A6: contagem mensal de outbound por tenant (cap de plano)
  @@map("ai_messages")
}

model AiAction {
  id                String         @id @default(uuid())
  conversationId    String         @map("conversation_id")
  conversation      AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenantId          String         @map("tenant_id")
  correlationId     String         @map("correlation_id")
  actionType        ActionType     @map("action_type")
  status            ActionStatus   @default(requested)
  requestedByAi     Boolean        @default(true) @map("requested_by_ai")
  executedByBackend Boolean        @default(false) @map("executed_by_backend")
  idempotencyKey    String         @unique @map("idempotency_key")
  payload           Json           @default("{}")
  result            Json?
  error             Json?
  createdAt         DateTime       @default(now()) @map("created_at")
  executedAt        DateTime?      @map("executed_at")

  @@index([tenantId])
  @@index([correlationId])
  @@map("ai_actions")
}

model AiCustomerProfile {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  contactId         String   @unique @map("contact_id")
  externalContactId String?  @map("external_contact_id")
  industry          String?
  segment           String?
  fleetSize         Int?     @map("fleet_size")
  satisfactionScore Decimal? @map("satisfaction_score") @db.Decimal(3, 1)
  preferredTone     String?  @map("preferred_tone")
  notes             Json     @default("{}")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("ai_customer_profile")
}

model AiKnowledgeBase {
  id             String               @id @default(uuid())
  tenantId       String               @map("tenant_id")
  productCode    String?              @map("product_code")
  topic          String
  category       String
  title          String
  content        String
  tags           String[]
  embeddingModel String?              @map("embedding_model")
  // Vetor semântico (RAG / pgvector). Tipo não nativo do Prisma → lido/escrito via SQL bruto.
  embedding      Unsupported("vector(384)")?
  createdAt      DateTime             @default(now()) @map("created_at")
  // F11 (2026-08-06, fix de auditoria): retrieve() nunca respeitava
  // AiKnowledgeVersion.approved — um rascunho do TicketIntelligenceService
  // (autor "lucio", não revisado) ficava visível pra Lia assim que era criado.
  // Default TRUE de propósito: os 1438 artigos já existentes (conector +
  // painel) continuam visíveis sem backfill — só criações NOVAS com
  // autoApprove=false (hoje: só o Lúcio) nascem com approved=false.
  approved       Boolean              @default(true) @map("approved")

  versions AiKnowledgeVersion[]

  @@index([tenantId])
  @@index([category])
  @@index([tenantId, productCode]) // busca separada por produto (F8)
  @@map("ai_knowledge_base")
}

model AiKnowledgeVersion {
  id          String          @id @default(uuid())
  knowledgeId String          @map("knowledge_id")
  knowledge   AiKnowledgeBase @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  version     Int
  content     String
  approved    Boolean         @default(false)
  author      String?
  reviewer    String?
  approvedAt  DateTime?       @map("approved_at")
  validUntil  DateTime?       @map("valid_until")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([knowledgeId])
  @@map("ai_knowledge_versions")
}

model DomainEvent {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  correlationId  String        @map("correlation_id")
  eventType      String        @map("event_type")
  producer       String?
  priority       EventPriority @default(media)
  subjectId      String?       @map("subject_id")
  payload        Json          @default("{}")
  status         EventStatus   @default(created)
  idempotencyKey String        @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  processedAt    DateTime?     @map("processed_at")

  @@index([tenantId])
  @@index([correlationId])
  @@index([status])
  @@map("domain_events")
}

model EventDlq {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  correlationId   String?   @map("correlation_id")
  originalEventId String?   @map("original_event_id")
  eventType       String    @map("event_type")
  payload         Json      @default("{}")
  error           String?
  retryCount      Int       @default(0) @map("retry_count")
  status          DlqStatus @default(pending)
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("event_dlq")
}

// ===================== TENANTS / CLIENTES (Platform Admin) =====================
// Dá nome aos tenantId já em uso. Platform-admin (User.tenantId = null) lista e
// "entra" num Tenant via header X-Acting-Tenant-Id (resolvido no backend).
// Por ora NÃO viramos os tenantId String em FK (migration grande e arriscada —
// ver docs/features/platform-admin/implementation.md §5.1).
model Tenant {
  id           String   @id @default(uuid())
  name         String // "HiperTMS"
  slug         String   @unique // "hipertms"
  status       String   @default("active") // active | suspended
  productId    String?  @map("product_id") // opcional: vincula ao conector/produto
  supportEmail String?  @map("support_email") // legado — migrado para SupportEmailRoute default; mantido para rollback
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  supportEmailRoutes SupportEmailRoute[]

  @@map("tenants")
}

// ===================== PRODUTOS / CONECTORES (ADR 009/010) =====================
model Product {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  connector String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  credentials ProductConnectorCredential[]

  @@map("products")
}

// (Billing removido — pagamento é feito no site do HiperTMS, não no Nexa.)

model ProductConnectorCredential {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  credentialType  String   @map("credential_type")
  encryptedSecret String   @map("encrypted_secret")
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([productId])
  @@map("product_connector_credentials")
}

// ===================== VENDEDORES / HANDOFF (Sprint 14 — paridade n8n) =====================
model Seller {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  phone         String // WhatsApp do vendedor (ex 5511994327713)
  active        Boolean  @default(true)
  // ADR 034 ("Estou fora"): true → handoff notifica também no WhatsApp do
  // vendedor (com deep link pro inbox); false → só sino do portal. Default
  // true preserva o comportamento pré-ADR (todo vendedor recebia WhatsApp).
  outOfOffice   Boolean  @default(true) @map("out_of_office")
  assignedCount Int      @default(0) @map("assigned_count") // round-robin balanceado
  createdAt     DateTime @default(now()) @map("created_at")

  conversations AiConversation[]
  notifications SellerNotification[]
  opportunities Opportunity[] // F6+ (seller-leads): leads atribuidos a este vendedor
  activities    SellerActivity[] // F7 (RevOps): ligacoes/e-mails/notas registrados manualmente

  @@index([tenantId])
  @@map("sellers")
}

// F7 (2026-08-05, expansao RevOps): registro manual de atividade do vendedor
// humano — ate aqui nao existia NENHUM log de ligacao/e-mail manual, entao os
// KPIs de vendedor (metrics.service.ts) so liam AiConversation/AiMessage.
// type/result sao texto, nao enum — mesmo padrao de Opportunity.stage, evolui
// sem migration.
model SellerActivity {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  sellerId      String       @map("seller_id")
  seller        Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  opportunityId String?      @map("opportunity_id")
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  type          String // call | email | note
  result        String? // atendeu | nao_atendeu | agendou_retorno | enviado | respondido | outro
  durationSec   Int?     @map("duration_sec") // so faz sentido pra type=call
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, sellerId])
  @@index([tenantId, opportunityId])
  @@map("seller_activities")
}

model SellerNotification {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  sellerId       String   @map("seller_id")
  seller         Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  conversationId String   @map("conversation_id")
  contactPhone   String   @map("contact_phone")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([conversationId]) // dedup: 1 notificação por conversa
  @@index([tenantId])
  @@map("seller_notifications")
}

// ===================== SENDER / NUMBER_POOL (Sprint 15 — disparo + anti-ban) =====================
// Pool de números do WhatsApp p/ disparo, com limite diário (anti-ban).
model SenderNumber {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  phone       String // número que envia (o da sessão WAHA)
  sessionName String   @default("default") @map("session_name")
  active       Boolean  @default(true)
  dailyLimit   Int      @default(30) @map("daily_limit") // anti-ban
  sentToday    Int      @default(0) @map("sent_today")
  dayStamp     String?  @map("day_stamp") // YYYY-MM-DD do contador
  hourlyLimit  Int      @default(8) @map("hourly_limit") // limite por hora (G6)
  sentThisHour Int      @default(0) @map("sent_this_hour")
  hourStamp    String?  @map("hour_stamp") // YYYY-MM-DD-HH
  warmupStage  Int      @default(0) @map("warmup_stage") // aquecimento (G7)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("sender_numbers")
}

// Campanha de disparo (lista de leads + mensagem com {{nome}}).
model Campaign {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  name      String
  channel   String    @default("whatsapp") @map("channel") // whatsapp | email
  // F8 (parceiros multi-produto): de qual produto esta campanha fala. O lead
  // herda na conversa e a busca de KB filtra por ele. NULL = produto principal.
  productCode String? @map("product_code")
  template  String // texto; suporta {{nome}} e {{saudacao}}
  subject   String?   // assunto do e-mail (obrigatório para channel=email)
  status    String    @default("draft") // draft | running | paused | done
  link            String? // link opcional
  sendLinkOnFirst Boolean @default(false) @map("send_link_on_first") // false = só envia link após resposta (anti-spam)
  mediaUrl  String?   @map("media_url")
  mediaName String?   @map("media_name")
  sendLimit Int?      @map("send_limit")
  // Canal Status WhatsApp (ADR-026) — aditivo; default "message" preserva campanhas existentes
  type           String    @default("message") // "message" | "status"
  statusPostId   String?   @map("status_post_id")    // id do post retornado pelo WAHA
  statusPostedAt DateTime? @map("status_posted_at")  // quando o status foi publicado
  createdAt DateTime  @default(now()) @map("created_at")
  startedAt DateTime? @map("started_at")
  archivedAt DateTime? @map("archived_at") // arquivada (guardada) — escondida da lista padrão
  scheduledAt DateTime? @map("scheduled_at") // agendamento: só começa a enviar a partir desse horário

  targets CampaignTarget[]

  @@index([tenantId])
  @@index([archivedAt])
  @@map("campaigns")
}

// Configuração de horário de envio por tenant (janela comercial, por canal).
// Editável na tela de Disparo. Fallback para os defaults caso não exista linha.
model SenderSettings {
  id             String   @id @default(uuid())
  tenantId       String   @unique @map("tenant_id")
  waStartHour    Int      @default(7)  @map("wa_start_hour")
  waEndHour      Int      @default(19) @map("wa_end_hour")
  emailStartHour Int      @default(8)  @map("email_start_hour")
  emailEndHour   Int      @default(18) @map("email_end_hour")
  updatedAt      DateTime @updatedAt @default(now()) @map("updated_at")

  @@map("sender_settings")
}

model CampaignTarget {
  id         String    @id @default(uuid())
  campaignId String    @map("campaign_id")
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenantId   String    @map("tenant_id")
  phone      String    @default("") // WhatsApp: número real; e-mail: vazio ou "email:<addr>"
  email      String?   // e-mail do destinatário (canal email)
  name       String?
  status     String    @default("queued") // queued | sent | failed | skipped | sending
  sentAt     DateTime? @map("sent_at")
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([campaignId])
  @@index([status])
  // DISP-005: query mais quente do worker — próximo alvo de UMA campanha, por
  // status, na ordem de criação. Os dois índices acima resolviam só metade dela.
  @@index([campaignId, status, createdAt])
  @@map("campaign_targets")
}

// Dedup de mensagens inbound do WAHA — evita processar/responder a mesma 2x (reentrega/reconexão).
model ProcessedMessage {
  id        String   @id @default(uuid())
  messageId String   @unique @map("message_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("processed_messages")
}

// Monitoramento INTERNO de reclamações (cliente não sabe; só registro) — business-rules §11.
model Complaint {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  phone          String
  topic          String // lentidao | bug | preco | atendimento | fiscal | outro
  excerpt        String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("complaints")
}

// Notificações do painel (sino) — alertas pro time (lead quente, reclamação, opt-out).
model Notification {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  type      String // hot_lead | complaint | opt_out | info
  title     String
  body      String   @default("")
  link      String? // rota no painel (ex.: /inbox)
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, read])
  @@map("notifications")
}

// Playbook de vendas editável pelo painel (objeções, tom, CTAs) — sem mexer no código.
model SalesPlaybook {
  id         String   @id @default(uuid())
  tenantId   String   @unique @map("tenant_id")
  persona    String   @default("") // tom/identidade extra injetado no prompt (VENDAS)
  supportPersona String @default("") @map("support_persona") // tom extra injetado no prompt (SUPORTE)
  objections Json     @default("[]") // [{ objection, guidance }]
  ctaCold    String   @default("") @map("cta_cold")
  ctaWarm    String   @default("") @map("cta_warm")
  ctaHot     String   @default("") @map("cta_hot")
  signupUrl  String   @default("") @map("signup_url")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("sales_playbook")
}

// ===================== CANAL E-MAIL (ADR 021) =====================
// Configuração do canal de e-mail por tenant.
model EmailChannel {
  id           String   @id @default(uuid())
  tenantId     String   @unique @map("tenant_id")
  provider     String   @default("smtp") // smtp | mailgun
  // Remetente
  fromEmail    String   @map("from_email")    // ex: lia@hipertms.com.br
  fromName     String   @default("Lia HiperTMS") @map("from_name")
  replyTo      String?  @map("reply_to")     // ex: contato@hipertms.com.br
  // SMTP (envio)
  smtpHost     String   @default("mail.hipertms.com.br") @map("smtp_host")
  smtpPort     Int      @default(465) @map("smtp_port")
  smtpUser     String   @map("smtp_user")    // ex: lia@hipertms.com.br
  smtpPass     String   @map("smtp_pass")    // criptografado no deploy
  smtpSecure   Boolean  @default(true) @map("smtp_secure") // true = SSL/TLS na porta 465
  // IMAP (recebimento por polling)
  imapHost     String   @default("mail.hipertms.com.br") @map("imap_host")
  imapPort     Int      @default(993) @map("imap_port")
  imapUser     String   @map("imap_user")
  imapPass     String   @map("imap_pass")
  imapMailbox  String   @default("INBOX") @map("imap_mailbox")
  // Controle
  isActive     Boolean  @default(true) @map("is_active")
  lastPollAt   DateTime? @map("last_poll_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("email_channels")
}

// Token de opt-out para descadastro em 2 passos (ADR 021 D9 + Adendo)
// TTL 30 dias. Uso único (usedAt preenchido após confirmação).
model EmailOptOutToken {
  id        String    @id @default(uuid())
  token     String    @unique
  tenantId  String    @map("tenant_id")
  contactId String    @map("contact_id")   // contato vinculado
  email     String                          // e-mail que pediu o opt-out
  usedAt    DateTime? @map("used_at")      // null = ainda não confirmado
  expiresAt DateTime  @map("expires_at")   // TTL 30 dias
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([token])
  @@index([tenantId])
  @@map("email_optout_tokens")
}

// Registro PERMANENTE de quem pediu para não receber mais (LGPD).
//
// Existe separado de `Contact` de propósito: em 2026-08-03 um contato que havia
// pedido opt-out foi apagado numa limpeza da base e, ao reimportar o CSV antigo,
// voltou como `active` e recebeu campanha de novo. O opt-out morava só no
// status do contato — apagou o contato, apagou o pedido dela.
//
// Esta tabela NÃO deve ser limpa junto com contatos. É a lista de bloqueio.
model OptOutRecord {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  phone     String?                         // WhatsApp (dígitos)
  email     String?                         // canal e-mail
  reason    String?                         // pedido | hostilidade | link_email | manual
  createdAt DateTime @default(now()) @map("created_at")

  // Postgres permite vários NULL num índice único, então um registro só de
  // telefone e outro só de e-mail convivem sem conflito.
  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("opt_out_records")
}

// Recuperação de senha ("Esqueceu a senha?"). Uso único, TTL curto (30min).
// Guardamos o HASH do token, não ele em claro: se o banco vazar, os links de
// redefinição em aberto continuam inúteis — mesma lógica do refresh token.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  usedAt    DateTime? @map("used_at")    // null = ainda não usado
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// Handoff token — botão "Falar com a Lia" no painel TMS (ADR 022 Modalidade B)
// Gerado pelo Nexa a pedido do TMS (server-to-server). TTL 5min. Uso único.
model HandoffToken {
  id         String    @id @default(uuid())
  token      String    @unique  // nanoid 8 chars — curto e URL-safe
  tenantId   String    @map("tenant_id")
  externalId String    @map("external_id") // externalId do cliente no TMS
  name       String?   @map("user_name")   // nome do usuário LOGADO no TMS (identidade segura — vem do token, nunca do WhatsApp)
  page       String?                       // página de origem (ex: "fiscal/cte")
  errorCode  String?   @map("error_code")  // código de erro visível na tela, se houver
  isManager  Boolean   @default(false) @map("is_manager") // gestor pode ver chamados de toda a empresa
  usedAt     DateTime? @map("used_at")     // null = ainda não usado
  expiresAt  DateTime  @map("expires_at")  // TTL 5 minutos
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([token])
  @@index([tenantId])
  @@map("handoff_tokens")
}

// Follow-up automático (cadência 24h/72h pra quem não respondeu).
model FollowUp {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @unique @map("conversation_id")
  phone          String
  name           String?
  stage          Int      @default(0) // 0=aguarda stage1; 1=mandou stage1; 2=mandou stage2 (fim)
  status         String   @default("pending") // pending | done | stopped (respondeu/optout)
  nextRunAt      DateTime @map("next_run_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([status])
  @@map("follow_ups")
}

// ===================== OPORTUNIDADES (F6 — funil comercial) =====================
// Lead com score >= 70 vira oportunidade (regras de negocio). Estagio textual
// (new|qualified|proposal|won|lost) para evoluir sem migration de enum.
model Opportunity {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  contactId      String?  @map("contact_id")
  conversationId String?  @map("conversation_id") // origem (lead quente)
  phone          String?
  name           String?
  company        String?
  stage          String   @default("new") // new | qualified | proposal | paused | won | lost | discarded
  interestScore  Int      @default(0) @map("interest_score")
  intent         String?
  summary        String?
  value          Decimal? @db.Decimal(12, 2) // valor estimado (opcional)
  assignedTo     String?  @map("assigned_to") // legado: nome livre (exibicao) — fonte de verdade e assignedSellerId
  // F6+ (2026-07-20, seller-leads): dono real do lead (FK) — escopo do login vendedor.
  assignedSellerId String? @map("assigned_seller_id")
  assignedSeller Seller?  @relation(fields: [assignedSellerId], references: [id], onDelete: SetNull)
  pausedUntil    DateTime? @map("paused_until")   // stage=paused: quando retomar
  discardReason  String?   @map("discard_reason") // stage=discarded: sem_fit | sem_resposta | concorrente | outro
  // F7 (RevOps): ultimo aviso de "lead parado" — evita repetir o mesmo lead
  // todo dia no sino ate alguem mexer nele.
  staleNotifiedAt DateTime? @map("stale_notified_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  stageHistory   OpportunityStageHistory[]
  activities     SellerActivity[] // F7 (RevOps): ligacoes/e-mails/notas registrados manualmente

  // F7 (RevOps, 2026-08-05): compartilhamento com parceiro externo (ex.:
  // pneus). sharedWithPartnerId NAO e um segundo tenant — e uma empresa de
  // fora do Nexa. partnerConsentAt precisa estar preenchido ANTES de
  // partnerSharedAt (gate aplicado em opportunities.service.ts, LGPD).
  sharedWithPartnerId String?   @map("shared_with_partner_id")
  sharedWithPartner   Partner?  @relation(fields: [sharedWithPartnerId], references: [id], onDelete: SetNull)
  partnerShareStatus  String?   @map("partner_share_status") // pending | shared | accepted | rejected | converted
  partnerSharedAt     DateTime? @map("partner_shared_at")
  partnerConsentAt    DateTime? @map("partner_consent_at") // presenca = consentimento dado (auditavel: QUANDO)

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, conversationId])
  @@index([tenantId, assignedSellerId])
  @@index([tenantId, sharedWithPartnerId])
  @@index([tenantId, updatedAt])
  @@map("opportunities")
}

// F7 (2026-08-05, expansao RevOps): empresa parceira EXTERNA (ex.: fornecedor
// de pneus) que recebe lead qualificado por indicacao/cross-sell. NAO e um
// Tenant — nunca ganha acesso ao Nexa, so recebe o dado do lead compartilhado
// (com consentimento, ver Opportunity.partnerConsentAt).
model Partner {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  type         String // ex: 'pneus'
  active       Boolean  @default(true)
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  createdAt    DateTime @default(now()) @map("created_at")

  sharedLeads  Opportunity[]

  @@index([tenantId])
  @@map("partners")
}

model OpportunityStageHistory {
  id            String      @id @default(uuid())
  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage     String?     @map("from_stage")
  toStage       String      @map("to_stage")
  reason        String?
  changedAt     DateTime    @default(now()) @map("changed_at")

  @@index([opportunityId])
  @@map("opportunity_stage_history")
}

// ===================== WEBHOOKS OUTBOUND =====================
// Assinaturas de webhook por tenant. O Nexa dispara eventos HTTP para a URL registrada
// com HMAC-SHA256 (header X-Nexa-Signature). Retry com backoff exponencial até 5x.
model WebhookSubscription {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  url        String                           // destino dos eventos
  secret     String                           // segredo HMAC (AES-256-GCM criptografado)
  events     String[]  @default([])           // ex: ["conversation.created", "ticket.escalated"]
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_subscriptions")
}

// Histórico de entregas — útil para debug no painel e retry manual.
model WebhookDelivery {
  id             String              @id @default(uuid())
  subscriptionId String              @map("subscription_id")
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event          String                         // nome do evento
  payload        Json                           // corpo enviado
  status         String              @default("pending") // pending | delivered | failed
  attempts       Int                 @default(0)
  nextRetryAt    DateTime?           @map("next_retry_at")
  responseStatus Int?                @map("response_status")
  error          String?
  deliveredAt    DateTime?           @map("delivered_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([subscriptionId, status])
  @@map("webhook_deliveries")
}

// ===================== LIMITES DE PLANO (NEXA-07) =====================
// Define os limites por tenant. Um registro por tenant — sem eles, sem limite aplicado.
model PlanLimit {
  id               String   @id @default(uuid())
  tenantId         String   @unique @map("tenant_id")
  maxContacts      Int?     @map("max_contacts")       // null = ilimitado
  maxCampaigns     Int?     @map("max_campaigns")      // null = ilimitado
  maxMessagesMonth Int?     @map("max_messages_month") // null = ilimitado
  plan                String   @default("free")           // free | starter | essencial | pro | enterprise | profissional | corporativo
  monitorExtraNumbers Int      @default(0) @map("monitor_extra_numbers") // extra WA numbers purchased (R$29.90/mo each)
  // WA numbers included in the plan, as told by the TMS (source of truth for the
  // plan catalogue — ADR 011). null = TMS has not synced it yet → fall back to
  // MONITOR_WA_INCLUDED. -1 = unlimited (Corporativo), capped at the technical limit.
  monitorNumbersIncluded Int?  @map("monitor_numbers_included")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("plan_limits")
}

// ===================== MONITOR PROATIVO =====================
// Configuração de notificações proativas por tenant.
model TenantNotificationConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique @map("tenant_id")
  enabled              Boolean  @default(false) @map("enabled")         // on/off por tenant
  sendHour             Int      @default(7) @map("send_hour")            // hora UTC de envio (0-23)
  sendMinute           Int      @default(0) @map("send_minute")          // minuto de envio (0|15|30|45)
  notificationPhone    String?  @map("notification_phone")               // telefone destino (legado)
  recipients           Json     @default("[]") @map("recipients")         // legado — mantido para compat
  sendWeekends         Boolean  @default(false) @map("send_weekends")
  channel         String   @default("whatsapp") // whatsapp | email | both
  fiscalEnabled   Boolean  @default(true) @map("fiscal_enabled")
  logisticEnabled Boolean  @default(true) @map("logistic_enabled")
  frotaEnabled    Boolean  @default(true) @map("frota_enabled")
  financeEnabled  Boolean  @default(true) @map("finance_enabled")
  sectorConfig       Json?    @map("sector_config")       // { fiscal|logistic|frota|finance: { phone, email, recipients[], sendHour, sendMinute, sendDays } }
  // T6 (2026-07): horário de envio migra de setor para contato. Cada contato tem até 3
  // horários próprios + lista de setores que assina. Fonte de verdade quando presente;
  // sectorConfig continua sendo escrito em paralelo (phone/email = 1º contato de cada
  // canal por setor) para não quebrar tenants/Nexa antigos que só leem o formato por setor.
  // Shape: [{ id, whatsapp?, emails[], sectors[], sendTimes[](<=3 {hour,minute}), sendDays[], lastDigestDate? }]
  contacts           Json?    @map("contacts")
  // G4: severidade mínima para notificação WhatsApp imediata.
  // 'CRITICAL' (default) = só alertas CRITICAL notificam imediatamente.
  // 'all' = todo evento novo notifica (comportamento pré-G4).
  immediateSeverity  String   @default("CRITICAL") @map("immediate_severity")
  // T9 (2026-07-17): janela geral de envio — nada dispara fora dela (digest,
  // fechamento e caixa respeitam sempre, inclusive catch-up). Imediatos CRITICAL
  // seguem `criticalOutsideWindow`: 'hold' (default, segura até abrir) ou 'send'
  // (fura a janela, comportamento pré-T9). Granularidade de hora.
  sendWindowStart        Int    @default(6)    @map("send_window_start")
  sendWindowEnd          Int    @default(20)   @map("send_window_end")
  criticalOutsideWindow  String @default("hold") @map("critical_outside_window")
  monitorOverride Boolean  @default(false) @map("monitor_override") // platform-admin override: unlock monitor regardless of plan
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("tenant_notification_configs")
}

// Estado dos alertas sincronizados do TMS.
model AlertState {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  tmsEventId   String    @map("tms_event_id")
  severity     String    // CRITICAL | OVERDUE | DUE_SOON | INFO
  category     String    // fiscal | logistic | frota | finance
  title        String
  description  String?
  status       String    @default("open") // open | snoozed | resolved | archived
  snoozedUntil DateTime? @map("snoozed_until")
  notifiedAt   DateTime? @map("notified_at")
  notifyCount  Int       @default(0) @map("notify_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, tmsEventId])
  @@index([tenantId, status])
  @@map("alert_states")
}

// Log de cada disparo de notificação (audit + debug).
model NotificationLog {
  id       String   @id @default(cuid())
  tenantId String   @map("tenant_id")
  channel  String   // whatsapp | email
  content  String
  sentAt   DateTime @default(now()) @map("sent_at")
  success  Boolean
  error    String?

  @@index([tenantId])
  @@map("notification_logs")
}

// Kill switch da autonomia da IA (ADR 012) — GLOBAL/singleton (uma linha id="global").
// `master` é o botão de pânico (desliga tudo). `whatsapp`/`email` ligam/desligam a Lia
// por canal. Autonomia efetiva de um canal = master AND canal. Persistido para
// sobreviver a restart (não religa a Lia sozinho).
model AutonomySetting {
  id        String   @id @default("global")
  master    Boolean  @default(true)
  whatsapp  Boolean  @default(true)
  email     Boolean  @default(true)
  changedBy String?  @map("changed_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("autonomy_setting")
}

// ── Motor Proativo (ADR 022-024 adaptado) ─────────────────────────────────────
//
// PendingConversationEvent: cada evento detectado pelo motor proativo.
// dedupeKey garante idempotência: mesmo ruleId+subjectId+bucket não cria duplicata.
// Executor só age em status=OPEN com level L2/L3 (respeitando kill switch).

model PendingConversationEvent {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  ruleId     String    @map("rule_id")    // conversation.stale_open | conversation.lead_no_reply | ...
  subjectId  String    @map("subject_id") // conversationId ou campaignTargetId
  dedupeKey  String    @unique @map("dedupe_key") // tenantId:ruleId:subjectId:bucket
  level      String    // L1 | L2 | L3
  severity   String    // INFO | DUE_SOON | OVERDUE | CRITICAL
  status     String    @default("OPEN") // OPEN | RESOLVED | AUTO_EXECUTED | DISMISSED
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([tenantId, status])
  @@index([tenantId, ruleId, status])
  @@map("pending_conversation_events")
}

// ProactiveRuleConfig: configuração por tenant de cada regra.
// Criada no onboarding com defaults globais. Admin pode ajustar threshold/enabled/level.
model ProactiveRuleConfig {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  ruleId       String   @map("rule_id")
  enabled      Boolean  @default(true)
  level        String   @default("L1") // L1 | L2 | L3
  thresholdMin Int      @default(240)  @map("threshold_min") // minutos — cada regra usa o seu
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt     @map("updated_at")

  @@unique([tenantId, ruleId])
  @@index([tenantId])
  @@map("proactive_rule_configs")
}

// C2: contador atômico de tickets por tenant (substitui MAX+1 com race condition).
// INSERT ... ON CONFLICT DO UPDATE SET last_number = last_number + 1 RETURNING last_number
// é atômico no PostgreSQL — sem race condition sob alta concorrência ou múltiplas réplicas.
model TicketCounter {
  tenantId   String   @id @map("tenant_id")
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @updatedAt  @map("updated_at")

  @@map("ticket_counters")
}

// ===================== ROTEAMENTO DE E-MAIL DE SUPORTE =====================
// Mapeia categoria de chamado para destinatario do e-mail de escalacao por tenant.
// category = null = rota padrao (fallback quando nao ha rota especifica).
// Listener: busca por (tenantId, ticketCategory) -> (tenantId, null) -> SUPPORT_EMAIL env.
model SupportEmailRoute {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  category  String?  @map("category")  // null = rota padrao
  email     String
  label     String?  // rotulo exibido na UI (ex: "Fiscal", "Financeiro")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt       @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, category])
  @@index([tenantId])
  @@map("support_email_routes")
}
