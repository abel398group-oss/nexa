// ============================================================================
// Nexa — Schema Prisma (Sprint 1 / Fase 1 core)
// Derivado de docs-leads/schema/schema.prisma. Só as tabelas da Fase 1.
// As demais (agentes, billing avançado, health, etc.) entram em migrations seguintes.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================
enum SourceChannel {
  whatsapp
  telegram
  site
  instagram
  facebook
  email
  portal
  web_chat // ADR 027: chat embutido no HiperTMS (widget ao lado do chat interno)
}

enum AgentType {
  router
  sdr
  sales
  onboarding
  support
  billing
  knowledge
  analytics
}

enum CustomerStage {
  lead
  cliente_novo
  cliente_ativo
}

enum ConversationStatus {
  open
  waiting_customer   // aguardando resposta do lead
  waiting_internal   // aguardando ação interna (vendedor, suporte)
  escalated
  opt_out            // lead pediu descadastro — fecha imediatamente
  closed             // fechado por regra automática ou ação manual
}

enum MessageDirection {
  inbound
  outbound
}

enum ActionType {
  create_payment
  get_payment_status
  consult_plan
  escalate
  update_context
  cancel_payment
  refund
  cancel_subscription
  delete_customer
  alter_contract
}

enum ActionStatus {
  requested
  validated
  executed
  blocked
  failed
}

enum EventStatus {
  created
  queued
  processing
  processed
  failed
}

enum EventPriority {
  alta
  media
  baixa
}

enum DlqStatus {
  pending
  reprocessed
  discarded
}

// ===================== AUTH (Sprint 2) =====================
enum UserRole {
  admin
  gestor
  operacional
  financeiro
  vendedor
}

model User {
  id           String    @id @default(uuid())
  tenantId     String?   @map("tenant_id") // null = admin da plataforma
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         UserRole  @default(operacional)
  sellerId     String?   @map("seller_id") // se role=vendedor, vincula ao cadastro Seller
  permissions  String[]  @default([]) // áreas liberadas p/ não-admin (admin = tudo)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions Session[]

  @@index([tenantId])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  revokedAt        DateTime? @map("revoked_at") // revogação de sessão
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String?  @map("tenant_id")
  userId        String?  @map("user_id")
  action        String
  resource      String?
  metadata      Json     @default("{}")
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@map("audit_logs")
}

// ===================== CONTATOS (Sprint 3) =====================
model Contact {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  phone             String
  name              String?
  nameSource        String?  @default("pushname") @map("name_source") // pushname | tms | manual (ADR 020)
  company           String?
  email             String?  // armazenar NULL quando ausente — NUNCA string vazia (ADR 021)
  source            String?  // origem do lead (consent_source — LGPD)
  status            String   @default("active") // active / opted_out
  leadStatus        String?  @map("lead_status") // new / cold / warm / hot
  interestScore     Int      @default(0) @map("interest_score")
  externalContactId String?  @map("external_contact_id") // ref no produto/TMS
  tags              String[]
  notes             String?
  optOutAt          DateTime? @map("opt_out_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, phone])
  @@unique([tenantId, email])  // NULL é OK — Postgres aceita múltiplos NULL em unique (ADR 021)
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, externalContactId])
  @@map("contacts")
}

// ===================== FASE 1 — CORE =====================
model AiConversation {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  productCode   String?            @map("product_code")
  externalId    String?            @map("external_id") // cliente externo (TMS) — usado pelo portal
  correlationId String             @map("correlation_id")
  contactId     String             @map("contact_id")
  phone         String
  sourceChannel SourceChannel      @map("source_channel")
  agentType     AgentType          @map("agent_type")
  customerStage CustomerStage      @map("customer_stage")
  status        ConversationStatus @default(open)
  startedAt     DateTime           @default(now()) @map("started_at")
  endedAt       DateTime?          @map("ended_at")
  createdAt     DateTime           @default(now()) @map("created_at")

  assignedSellerId String?   @map("assigned_seller_id")
  assignedSeller   Seller?   @relation(fields: [assignedSellerId], references: [id])
  assignedAt       DateTime? @map("assigned_at")
  lastActivityAt   DateTime? @map("last_activity_at") // atualizado a cada msg — base da regra de 7 dias
  outcome          String?   @map("outcome") // won | lost | no_response | opt_out | resolved
  outcomeAt        DateTime? @map("outcome_at")
  resolvedAt       DateTime? @map("resolved_at") // quando IA marcou como resolvido (suporte)
  autoCloseAt      DateTime? @map("auto_close_at") // timestamp p/ fechar automaticamente (resolvido+48h)
  ticketCategory   String?   @map("ticket_category") // fiscal | cte | mdfe | frete | financeiro | ...
  ticketPriority   String?   @map("ticket_priority") // critical | high | medium | low
  rootCause        String?   @map("root_cause") // causa-raiz classificada pelo DiagnosticAgent

  messages      AiMessage[]
  actions       AiAction[]
  stageHistory  ConversationStageHistory[]

  @@index([tenantId])
  @@index([correlationId])
  @@index([contactId])
  @@index([tenantId, externalId])
  @@index([status, lastActivityAt])
  @@map("ai_conversations")
}

// Histórico de mudanças de status e outcome — fonte para relatórios comerciais.
// Grava de→para sempre que status ou outcome muda (janitor, opt_out, won/lost, reabertura).
model ConversationStageHistory {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromStatus     String?   @map("from_status")
  toStatus       String    @map("to_status")
  fromOutcome    String?   @map("from_outcome")
  toOutcome      String?   @map("to_outcome")
  reason         String?   // inatividade_7d | opt_out | won | lost | reaberta | manual
  changedAt      DateTime  @default(now()) @map("changed_at")

  @@index([conversationId])
  @@index([changedAt])
  @@map("conversation_stage_history")
}

model AiMessage {
  id               String           @id @default(uuid())
  conversationId   String           @map("conversation_id")
  conversation     AiConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenantId         String           @map("tenant_id")
  correlationId    String           @map("correlation_id")
  direction        MessageDirection
  content          String
  metadata         Json             @default("{}")
  intent           String?
  promptVersion    String?          @map("prompt_version")
  kbVersion        String?          @map("kb_version")
  tokensIn         Int?             @map("tokens_in")
  tokensOut        Int?             @map("tokens_out")
  estimatedCostUsd Decimal?         @map("estimated_cost_usd") @db.Decimal(10, 6)
  actualCostUsd    Decimal?         @map("actual_cost_usd") @db.Decimal(10, 6)
  latencyMs        Int?             @map("latency_ms")
  externalId       String?          @map("external_id") // id da msg no WhatsApp (p/ casar recibos)
  ack              Int              @default(0) // 0 pend,1 enviado ✓,2 entregue ✓✓,3 lido ✓✓azul
  createdAt        DateTime         @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([correlationId])
  @@index([externalId])
  @@map("ai_messages")
}

model AiAction {
  id                String         @id @default(uuid())
  conversationId    String         @map("conversation_id")
  conversation      AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenantId          String         @map("tenant_id")
  correlationId     String         @map("correlation_id")
  actionType        ActionType     @map("action_type")
  status            ActionStatus   @default(requested)
  requestedByAi     Boolean        @default(true) @map("requested_by_ai")
  executedByBackend Boolean        @default(false) @map("executed_by_backend")
  idempotencyKey    String         @unique @map("idempotency_key")
  payload           Json           @default("{}")
  result            Json?
  error             Json?
  createdAt         DateTime       @default(now()) @map("created_at")
  executedAt        DateTime?      @map("executed_at")

  @@index([tenantId])
  @@index([correlationId])
  @@map("ai_actions")
}

model AiCustomerProfile {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  contactId         String   @unique @map("contact_id")
  externalContactId String?  @map("external_contact_id")
  industry          String?
  segment           String?
  fleetSize         Int?     @map("fleet_size")
  satisfactionScore Decimal? @map("satisfaction_score") @db.Decimal(3, 1)
  preferredTone     String?  @map("preferred_tone")
  notes             Json     @default("{}")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("ai_customer_profile")
}

model AiKnowledgeBase {
  id             String               @id @default(uuid())
  tenantId       String               @map("tenant_id")
  productCode    String?              @map("product_code")
  topic          String
  category       String
  title          String
  content        String
  tags           String[]
  embeddingModel String?              @map("embedding_model")
  // Vetor semântico (RAG / pgvector). Tipo não nativo do Prisma → lido/escrito via SQL bruto.
  embedding      Unsupported("vector(384)")?
  createdAt      DateTime             @default(now()) @map("created_at")

  versions AiKnowledgeVersion[]

  @@index([tenantId])
  @@index([category])
  @@map("ai_knowledge_base")
}

model AiKnowledgeVersion {
  id          String          @id @default(uuid())
  knowledgeId String          @map("knowledge_id")
  knowledge   AiKnowledgeBase @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  version     Int
  content     String
  approved    Boolean         @default(false)
  author      String?
  reviewer    String?
  approvedAt  DateTime?       @map("approved_at")
  validUntil  DateTime?       @map("valid_until")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([knowledgeId])
  @@map("ai_knowledge_versions")
}

model DomainEvent {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  correlationId  String        @map("correlation_id")
  eventType      String        @map("event_type")
  producer       String?
  priority       EventPriority @default(media)
  subjectId      String?       @map("subject_id")
  payload        Json          @default("{}")
  status         EventStatus   @default(created)
  idempotencyKey String        @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  processedAt    DateTime?     @map("processed_at")

  @@index([tenantId])
  @@index([correlationId])
  @@index([status])
  @@map("domain_events")
}

model EventDlq {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  correlationId   String?   @map("correlation_id")
  originalEventId String?   @map("original_event_id")
  eventType       String    @map("event_type")
  payload         Json      @default("{}")
  error           String?
  retryCount      Int       @default(0) @map("retry_count")
  status          DlqStatus @default(pending)
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("event_dlq")
}

// ===================== TENANTS / CLIENTES (Platform Admin) =====================
// Dá nome aos tenantId já em uso. Platform-admin (User.tenantId = null) lista e
// "entra" num Tenant via header X-Acting-Tenant-Id (resolvido no backend).
// Por ora NÃO viramos os tenantId String em FK (migration grande e arriscada —
// ver docs/features/platform-admin/implementation.md §5.1).
model Tenant {
  id        String   @id @default(uuid())
  name      String // "HiperTMS"
  slug      String   @unique // "hipertms"
  status    String   @default("active") // active | suspended
  productId String?  @map("product_id") // opcional: vincula ao conector/produto
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenants")
}

// ===================== PRODUTOS / CONECTORES (ADR 009/010) =====================
model Product {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  connector String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  credentials ProductConnectorCredential[]

  @@map("products")
}

// (Billing removido — pagamento é feito no site do HiperTMS, não no Nexa.)

model ProductConnectorCredential {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  credentialType  String   @map("credential_type")
  encryptedSecret String   @map("encrypted_secret")
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([productId])
  @@map("product_connector_credentials")
}

// ===================== VENDEDORES / HANDOFF (Sprint 14 — paridade n8n) =====================
model Seller {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  phone         String // WhatsApp do vendedor (ex 5511994327713)
  active        Boolean  @default(true)
  assignedCount Int      @default(0) @map("assigned_count") // round-robin balanceado
  createdAt     DateTime @default(now()) @map("created_at")

  conversations AiConversation[]
  notifications SellerNotification[]

  @@index([tenantId])
  @@map("sellers")
}

model SellerNotification {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  sellerId       String   @map("seller_id")
  seller         Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  conversationId String   @map("conversation_id")
  contactPhone   String   @map("contact_phone")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([conversationId]) // dedup: 1 notificação por conversa
  @@index([tenantId])
  @@map("seller_notifications")
}

// ===================== SENDER / NUMBER_POOL (Sprint 15 — disparo + anti-ban) =====================
// Pool de números do WhatsApp p/ disparo, com limite diário (anti-ban).
model SenderNumber {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  phone       String // número que envia (o da sessão WAHA)
  sessionName String   @default("default") @map("session_name")
  active       Boolean  @default(true)
  dailyLimit   Int      @default(30) @map("daily_limit") // anti-ban
  sentToday    Int      @default(0) @map("sent_today")
  dayStamp     String?  @map("day_stamp") // YYYY-MM-DD do contador
  hourlyLimit  Int      @default(8) @map("hourly_limit") // limite por hora (G6)
  sentThisHour Int      @default(0) @map("sent_this_hour")
  hourStamp    String?  @map("hour_stamp") // YYYY-MM-DD-HH
  warmupStage  Int      @default(0) @map("warmup_stage") // aquecimento (G7)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("sender_numbers")
}

// Campanha de disparo (lista de leads + mensagem com {{nome}}).
model Campaign {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  name      String
  channel   String    @default("whatsapp") @map("channel") // whatsapp | email
  template  String // texto; suporta {{nome}} e {{saudacao}}
  subject   String?   // assunto do e-mail (obrigatório para channel=email)
  status    String    @default("draft") // draft | running | paused | done
  link            String? // link opcional
  sendLinkOnFirst Boolean @default(false) @map("send_link_on_first") // false = só envia link após resposta (anti-spam)
  mediaUrl  String?   @map("media_url")
  mediaName String?   @map("media_name")
  sendLimit Int?      @map("send_limit")
  // Canal Status WhatsApp (ADR-026) — aditivo; default "message" preserva campanhas existentes
  type           String    @default("message") // "message" | "status"
  statusPostId   String?   @map("status_post_id")    // id do post retornado pelo WAHA
  statusPostedAt DateTime? @map("status_posted_at")  // quando o status foi publicado
  createdAt DateTime  @default(now()) @map("created_at")
  startedAt DateTime? @map("started_at")
  archivedAt DateTime? @map("archived_at") // arquivada (guardada) — escondida da lista padrão
  scheduledAt DateTime? @map("scheduled_at") // agendamento: só começa a enviar a partir desse horário

  targets CampaignTarget[]

  @@index([tenantId])
  @@index([archivedAt])
  @@map("campaigns")
}

// Configuração de horário de envio por tenant (janela comercial, por canal).
// Editável na tela de Disparo. Fallback para os defaults caso não exista linha.
model SenderSettings {
  id             String   @id @default(uuid())
  tenantId       String   @unique @map("tenant_id")
  waStartHour    Int      @default(7)  @map("wa_start_hour")
  waEndHour      Int      @default(19) @map("wa_end_hour")
  emailStartHour Int      @default(8)  @map("email_start_hour")
  emailEndHour   Int      @default(18) @map("email_end_hour")
  updatedAt      DateTime @updatedAt @default(now()) @map("updated_at")

  @@map("sender_settings")
}

model CampaignTarget {
  id         String    @id @default(uuid())
  campaignId String    @map("campaign_id")
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenantId   String    @map("tenant_id")
  phone      String    @default("") // WhatsApp: número real; e-mail: vazio ou "email:<addr>"
  email      String?   // e-mail do destinatário (canal email)
  name       String?
  status     String    @default("queued") // queued | sent | failed | skipped | sending
  sentAt     DateTime? @map("sent_at")
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([campaignId])
  @@index([status])
  @@map("campaign_targets")
}

// Dedup de mensagens inbound do WAHA — evita processar/responder a mesma 2x (reentrega/reconexão).
model ProcessedMessage {
  id        String   @id @default(uuid())
  messageId String   @unique @map("message_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("processed_messages")
}

// Monitoramento INTERNO de reclamações (cliente não sabe; só registro) — business-rules §11.
model Complaint {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  phone          String
  topic          String // lentidao | bug | preco | atendimento | fiscal | outro
  excerpt        String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("complaints")
}

// Notificações do painel (sino) — alertas pro time (lead quente, reclamação, opt-out).
model Notification {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  type      String // hot_lead | complaint | opt_out | info
  title     String
  body      String   @default("")
  link      String? // rota no painel (ex.: /inbox)
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, read])
  @@map("notifications")
}

// Playbook de vendas editável pelo painel (objeções, tom, CTAs) — sem mexer no código.
model SalesPlaybook {
  id         String   @id @default(uuid())
  tenantId   String   @unique @map("tenant_id")
  persona    String   @default("") // tom/identidade extra injetado no prompt (VENDAS)
  supportPersona String @default("") @map("support_persona") // tom extra injetado no prompt (SUPORTE)
  objections Json     @default("[]") // [{ objection, guidance }]
  ctaCold    String   @default("") @map("cta_cold")
  ctaWarm    String   @default("") @map("cta_warm")
  ctaHot     String   @default("") @map("cta_hot")
  signupUrl  String   @default("") @map("signup_url")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("sales_playbook")
}

// ===================== CANAL E-MAIL (ADR 021) =====================
// Configuração do canal de e-mail por tenant.
model EmailChannel {
  id           String   @id @default(uuid())
  tenantId     String   @unique @map("tenant_id")
  provider     String   @default("smtp") // smtp | mailgun
  // Remetente
  fromEmail    String   @map("from_email")    // ex: lia@hipertms.com.br
  fromName     String   @default("Lia HiperTMS") @map("from_name")
  replyTo      String?  @map("reply_to")     // ex: contato@hipertms.com.br
  // SMTP (envio)
  smtpHost     String   @default("mail.hipertms.com.br") @map("smtp_host")
  smtpPort     Int      @default(465) @map("smtp_port")
  smtpUser     String   @map("smtp_user")    // ex: lia@hipertms.com.br
  smtpPass     String   @map("smtp_pass")    // criptografado no deploy
  smtpSecure   Boolean  @default(true) @map("smtp_secure") // true = SSL/TLS na porta 465
  // IMAP (recebimento por polling)
  imapHost     String   @default("mail.hipertms.com.br") @map("imap_host")
  imapPort     Int      @default(993) @map("imap_port")
  imapUser     String   @map("imap_user")
  imapPass     String   @map("imap_pass")
  imapMailbox  String   @default("INBOX") @map("imap_mailbox")
  // Controle
  isActive     Boolean  @default(true) @map("is_active")
  lastPollAt   DateTime? @map("last_poll_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("email_channels")
}

// Token de opt-out para descadastro em 2 passos (ADR 021 D9 + Adendo)
// TTL 30 dias. Uso único (usedAt preenchido após confirmação).
model EmailOptOutToken {
  id        String    @id @default(uuid())
  token     String    @unique
  tenantId  String    @map("tenant_id")
  contactId String    @map("contact_id")   // contato vinculado
  email     String                          // e-mail que pediu o opt-out
  usedAt    DateTime? @map("used_at")      // null = ainda não confirmado
  expiresAt DateTime  @map("expires_at")   // TTL 30 dias
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([token])
  @@index([tenantId])
  @@map("email_optout_tokens")
}

// Handoff token — botão "Falar com a Lia" no painel TMS (ADR 022 Modalidade B)
// Gerado pelo Nexa a pedido do TMS (server-to-server). TTL 5min. Uso único.
model HandoffToken {
  id         String    @id @default(uuid())
  token      String    @unique  // nanoid 8 chars — curto e URL-safe
  tenantId   String    @map("tenant_id")
  externalId String    @map("external_id") // externalId do cliente no TMS
  name       String?   @map("user_name")   // nome do usuário LOGADO no TMS (identidade segura — vem do token, nunca do WhatsApp)
  page       String?                       // página de origem (ex: "fiscal/cte")
  errorCode  String?   @map("error_code")  // código de erro visível na tela, se houver
  usedAt     DateTime? @map("used_at")     // null = ainda não usado
  expiresAt  DateTime  @map("expires_at")  // TTL 5 minutos
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([token])
  @@index([tenantId])
  @@map("handoff_tokens")
}

// Follow-up automático (cadência 24h/72h pra quem não respondeu).
model FollowUp {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @unique @map("conversation_id")
  phone          String
  name           String?
  stage          Int      @default(0) // 0=aguarda stage1; 1=mandou stage1; 2=mandou stage2 (fim)
  status         String   @default("pending") // pending | done | stopped (respondeu/optout)
  nextRunAt      DateTime @map("next_run_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([status])
  @@map("follow_ups")
}

// ===================== OPORTUNIDADES (F6 — funil comercial) =====================
// Lead com score >= 70 vira oportunidade (regras de negocio). Estagio textual
// (new|qualified|proposal|won|lost) para evoluir sem migration de enum.
model Opportunity {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  contactId      String?  @map("contact_id")
  conversationId String?  @map("conversation_id") // origem (lead quente)
  phone          String?
  name           String?
  company        String?
  stage          String   @default("new") // new | qualified | proposal | won | lost
  interestScore  Int      @default(0) @map("interest_score")
  intent         String?
  summary        String?
  value          Decimal? @db.Decimal(12, 2) // valor estimado (opcional)
  assignedTo     String?  @map("assigned_to") // sellerId/nome do vendedor
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  stageHistory   OpportunityStageHistory[]

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, conversationId])
  @@map("opportunities")
}

model OpportunityStageHistory {
  id            String      @id @default(uuid())
  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage     String?     @map("from_stage")
  toStage       String      @map("to_stage")
  reason        String?
  changedAt     DateTime    @default(now()) @map("changed_at")

  @@index([opportunityId])
  @@map("opportunity_stage_history")
}

// Kill switch da autonomia da IA (ADR 012) — GLOBAL/singleton (uma linha id="global").
// `master` é o botão de pânico (desliga tudo). `whatsapp`/`email` ligam/desligam a Lia
// por canal. Autonomia efetiva de um canal = master AND canal. Persistido para
// sobreviver a restart (não religa a Lia sozinho).
model AutonomySetting {
  id        String   @id @default("global")
  master    Boolean  @default(true)
  whatsapp  Boolean  @default(true)
  email     Boolean  @default(true)
  changedBy String?  @map("changed_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("autonomy_setting")
}
