// ============================================================================
// Nexa — Schema Prisma (Sprint 1 / Fase 1 core)
// Derivado de docs-leads/schema/schema.prisma. Só as tabelas da Fase 1.
// As demais (agentes, billing avançado, health, etc.) entram em migrations seguintes.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================
enum SourceChannel {
  whatsapp
  telegram
  site
  instagram
  facebook
  email
}

enum AgentType {
  router
  sdr
  sales
  onboarding
  support
  billing
  knowledge
  analytics
}

enum CustomerStage {
  lead
  cliente_novo
  cliente_ativo
}

enum ConversationStatus {
  open
  escalated
  closed
}

enum MessageDirection {
  inbound
  outbound
}

enum ActionType {
  create_payment
  get_payment_status
  consult_plan
  escalate
  update_context
  cancel_payment
  refund
  cancel_subscription
  delete_customer
  alter_contract
}

enum ActionStatus {
  requested
  validated
  executed
  blocked
  failed
}

enum EventStatus {
  created
  queued
  processing
  processed
  failed
}

enum EventPriority {
  alta
  media
  baixa
}

enum DlqStatus {
  pending
  reprocessed
  discarded
}

enum BillingRequestStatus {
  requested
  processing
  link_sent
  pending_payment
  confirmed
  failed
  expired
  cancelled
}

// ===================== AUTH (Sprint 2) =====================
enum UserRole {
  admin
  gestor
  operacional
  financeiro
}

model User {
  id           String    @id @default(uuid())
  tenantId     String?   @map("tenant_id") // null = admin da plataforma
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         UserRole  @default(operacional)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions Session[]

  @@index([tenantId])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  revokedAt        DateTime? @map("revoked_at") // revogação de sessão
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String?  @map("tenant_id")
  userId        String?  @map("user_id")
  action        String
  resource      String?
  metadata      Json     @default("{}")
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@map("audit_logs")
}

// ===================== CONTATOS (Sprint 3) =====================
model Contact {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  phone             String
  name              String?
  company           String?
  email             String?
  source            String?  // origem do lead (consent_source — LGPD)
  status            String   @default("active") // active / opted_out
  leadStatus        String?  @map("lead_status") // new / cold / warm / hot
  interestScore     Int      @default(0) @map("interest_score")
  externalContactId String?  @map("external_contact_id") // ref no produto/TMS
  tags              String[]
  notes             String?
  optOutAt          DateTime? @map("opt_out_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("contacts")
}

// ===================== FASE 1 — CORE =====================
model AiConversation {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  productCode   String?            @map("product_code")
  correlationId String             @map("correlation_id")
  contactId     String             @map("contact_id")
  phone         String
  sourceChannel SourceChannel      @map("source_channel")
  agentType     AgentType          @map("agent_type")
  customerStage CustomerStage      @map("customer_stage")
  status        ConversationStatus @default(open)
  startedAt     DateTime           @default(now()) @map("started_at")
  endedAt       DateTime?          @map("ended_at")
  createdAt     DateTime           @default(now()) @map("created_at")

  messages AiMessage[]
  actions  AiAction[]

  @@index([tenantId])
  @@index([correlationId])
  @@index([contactId])
  @@map("ai_conversations")
}

model AiMessage {
  id               String           @id @default(uuid())
  conversationId   String           @map("conversation_id")
  conversation     AiConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenantId         String           @map("tenant_id")
  correlationId    String           @map("correlation_id")
  direction        MessageDirection
  content          String
  metadata         Json             @default("{}")
  intent           String?
  promptVersion    String?          @map("prompt_version")
  kbVersion        String?          @map("kb_version")
  tokensIn         Int?             @map("tokens_in")
  tokensOut        Int?             @map("tokens_out")
  estimatedCostUsd Decimal?         @map("estimated_cost_usd") @db.Decimal(10, 6)
  actualCostUsd    Decimal?         @map("actual_cost_usd") @db.Decimal(10, 6)
  latencyMs        Int?             @map("latency_ms")
  createdAt        DateTime         @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([correlationId])
  @@map("ai_messages")
}

model AiAction {
  id                String         @id @default(uuid())
  conversationId    String         @map("conversation_id")
  conversation      AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenantId          String         @map("tenant_id")
  correlationId     String         @map("correlation_id")
  actionType        ActionType     @map("action_type")
  status            ActionStatus   @default(requested)
  requestedByAi     Boolean        @default(true) @map("requested_by_ai")
  executedByBackend Boolean        @default(false) @map("executed_by_backend")
  idempotencyKey    String         @unique @map("idempotency_key")
  payload           Json           @default("{}")
  result            Json?
  error             Json?
  createdAt         DateTime       @default(now()) @map("created_at")
  executedAt        DateTime?      @map("executed_at")

  @@index([tenantId])
  @@index([correlationId])
  @@map("ai_actions")
}

model AiCustomerProfile {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  contactId         String   @unique @map("contact_id")
  externalContactId String?  @map("external_contact_id")
  industry          String?
  segment           String?
  fleetSize         Int?     @map("fleet_size")
  satisfactionScore Decimal? @map("satisfaction_score") @db.Decimal(3, 1)
  preferredTone     String?  @map("preferred_tone")
  notes             Json     @default("{}")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("ai_customer_profile")
}

model AiKnowledgeBase {
  id             String               @id @default(uuid())
  tenantId       String               @map("tenant_id")
  productCode    String?              @map("product_code")
  topic          String
  category       String
  title          String
  content        String
  tags           String[]
  embeddingModel String?              @map("embedding_model")
  createdAt      DateTime             @default(now()) @map("created_at")

  versions AiKnowledgeVersion[]

  @@index([tenantId])
  @@index([category])
  @@map("ai_knowledge_base")
}

model AiKnowledgeVersion {
  id          String          @id @default(uuid())
  knowledgeId String          @map("knowledge_id")
  knowledge   AiKnowledgeBase @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  version     Int
  content     String
  approved    Boolean         @default(false)
  author      String?
  reviewer    String?
  approvedAt  DateTime?       @map("approved_at")
  validUntil  DateTime?       @map("valid_until")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([knowledgeId])
  @@map("ai_knowledge_versions")
}

model DomainEvent {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  correlationId  String        @map("correlation_id")
  eventType      String        @map("event_type")
  producer       String?
  priority       EventPriority @default(media)
  subjectId      String?       @map("subject_id")
  payload        Json          @default("{}")
  status         EventStatus   @default(created)
  idempotencyKey String        @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  processedAt    DateTime?     @map("processed_at")

  @@index([tenantId])
  @@index([correlationId])
  @@index([status])
  @@map("domain_events")
}

model EventDlq {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  correlationId   String?   @map("correlation_id")
  originalEventId String?   @map("original_event_id")
  eventType       String    @map("event_type")
  payload         Json      @default("{}")
  error           String?
  retryCount      Int       @default(0) @map("retry_count")
  status          DlqStatus @default(pending)
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("event_dlq")
}

// ===================== PRODUTOS / CONECTORES (ADR 009/010) =====================
model Product {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  connector String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  credentials ProductConnectorCredential[]

  @@map("products")
}

// ===================== BILLING (Sprint 6 — rastreio local; TMS executa) =====================
model AiBillingRequest {
  id                     String               @id @default(uuid())
  conversationId         String?              @map("conversation_id")
  correlationId          String               @map("correlation_id")
  contactId              String?              @map("contact_id")
  tenantId               String?              @map("tenant_id")
  productCode            String?              @map("product_code")
  externalTenantId       String?              @map("external_tenant_id")
  planCode               String?              @map("plan_code")
  requestedAmount        Decimal?             @map("requested_amount") @db.Decimal(12, 2)
  idempotencyKey         String               @unique @map("idempotency_key")
  status                 BillingRequestStatus @default(requested)
  paymentLink            String?              @map("payment_link")
  externalSubscriptionId String?              @map("external_subscription_id")
  externalInvoiceId      String?              @map("external_invoice_id")
  externalPaymentId      String?              @map("external_payment_id")
  createdAt              DateTime             @default(now()) @map("created_at")
  confirmedAt           DateTime?            @map("confirmed_at")

  events       BillingEvent[]
  paymentSyncs PaymentStatusSync[]

  @@index([correlationId])
  @@index([tenantId])
  @@map("ai_billing_requests")
}

model BillingEvent {
  id               String           @id @default(uuid())
  billingRequestId String           @map("ai_billing_request_id")
  billingRequest   AiBillingRequest @relation(fields: [billingRequestId], references: [id], onDelete: Cascade)
  tenantId         String?          @map("tenant_id")
  correlationId    String?          @map("correlation_id")
  asaasPaymentId   String?          @map("asaas_payment_id")
  eventType        String           @map("event_type")
  rawPayload       Json             @default("{}") @map("raw_payload")
  signatureValid   Boolean          @default(false) @map("signature_valid")
  processed        Boolean          @default(false)
  idempotencyKey   String           @unique @map("idempotency_key")
  createdAt        DateTime         @default(now()) @map("created_at")

  @@index([billingRequestId])
  @@map("billing_events")
}

model PaymentStatusSync {
  id               String           @id @default(uuid())
  billingRequestId String           @map("ai_billing_request_id")
  billingRequest   AiBillingRequest @relation(fields: [billingRequestId], references: [id], onDelete: Cascade)
  asaasPaymentId   String?          @map("asaas_payment_id")
  expectedStatus   String?          @map("expected_status")
  actualStatus     String?          @map("actual_status")
  divergence       Boolean          @default(false)
  checkedAt        DateTime         @default(now()) @map("checked_at")

  @@index([billingRequestId])
  @@map("payment_status_sync")
}

model ProductConnectorCredential {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  credentialType  String   @map("credential_type")
  encryptedSecret String   @map("encrypted_secret")
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([productId])
  @@map("product_connector_credentials")
}
