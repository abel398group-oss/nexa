# ===== Nexa — variáveis de ambiente =====
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env real — ele está no .gitignore

# --- Banco ---
# Runtime da app. Em produção pode apontar pro CONNECTION POOL do DO (PgBouncer
# gerenciado) quando o item 1 do plano de escala for ativado — ver
# docs/infra/item1-pool-conexoes-2026-07.md. O limite efetivo de conexões é
# PRISMA_CONNECTION_LIMIT (default 3, ver prisma.service.ts), não o da URL.
DATABASE_URL="postgresql://nexa:SENHA@127.0.0.1:5433/nexa?schema=public&pool_timeout=10"
# Conexão DIRETA (porta 25060, sem pool) — SÓ definir ao ativar o pool do DO.
# Usada pelas migrations (`migrate deploy` quebra no pool transaction mode).
# Requer também adicionar `directUrl` no schema.prisma (ver nota lá).
# DIRECT_DATABASE_URL=""
TZ=America/Sao_Paulo

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT="6380"
REDIS_PASSWORD="SENHA_REDIS"

# --- IA (Anthropic) ---
# Gere uma nova key em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-api03-..."

# --- Auth ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="GERE_UM_SEGREDO_FORTE_AQUI"
JWT_REFRESH_SECRET="GERE_OUTRO_SEGREDO_FORTE_AQUI"

# --- Kill switch IA (ADR 012) ---
# "true" = Lia responde automaticamente | "false" = somente inbox manual
AI_AUTONOMY_ENABLED="true"

# --- CORS ---
# Em produção: coloque o domínio real separado por vírgula
# Ex: https://app.meudominio.com,https://admin.meudominio.com
CORS_ORIGINS="http://localhost:5173"

# --- Web Chat embutido (ADR 027) ---
# Origins permitidas para conexão WebSocket do widget LiaChat no HiperTMS.
# Em produção: domínio(s) do TMS separados por vírgula.
# Em desenvolvimento: qualquer origem é aceita (NODE_ENV != production).
# Ex: https://hipertms.com.br,https://staging.hipertms.com.br
WEBCHAT_ALLOWED_ORIGINS="http://localhost:5173"

# --- Webhook WAHA (OBRIGATÓRIO) ---
# Token secreto usado para autenticar o webhook do WAHA
# Configure o mesmo valor na URL do webhook no painel WAHA: ?token=SEU_TOKEN
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WAHA_WEBHOOK_TOKEN="GERE_UM_TOKEN_SECRETO_AQUI"

# --- WAHA (gateway WhatsApp) ---
WAHA_API_URL="http://localhost:3018"
WAHA_API_KEY="SUA_API_KEY_WAHA"
WAHA_SESSION="default"
# Lista de números permitidos para envio real (vazio = envia para todos)
# Ex: 5511999999999,5511888888888
WAHA_SEND_ALLOWLIST=""

# --- Anti-bloqueio: presença (parecer humano) ---
# Antes de responder numa conversa, marca as mensagens como lidas e mostra
# "digitando…" por um tempo proporcional ao texto. A doc do WAHA lista os dois
# como as primeiras recomendações contra bloqueio — um número que nunca lê e
# responde em 1,5s é perfil de robô. Só vale para conversa (resposta da Lia,
# inbox, 1ª mensagem de campanha); alerta automático não finge que alguém digitou.
WHATSAPP_PRESENCE_ENABLED="true"
# Teto do "digitando…" em ms (o tempo real é proporcional ao tamanho do texto)
WHATSAPP_TYPING_MAX_MS="5000"

# --- Anti-bloqueio: teto GLOBAL do número ---
# Os limites do disparo (dailyLimit/hourlyLimit em SenderNumber) contam só as
# campanhas. O mesmo chip também responde lead, manda digest do Monitor, avisa
# vendedor e fecha conversa. Estes tetos contam TUDO.
# Quando estouram, quem para é a CAMPANHA — alerta de cliente e resposta em
# conversa aberta nunca são bloqueados.
NUMBER_DAILY_CEILING="250"
NUMBER_HOURLY_CEILING="40"

# --- Anti-bloqueio: fechamento automático de conversa ---
# Janela de horário do janitor (default = mesma do disparo, SENDER_BUSINESS_*).
# Sem ela o ciclo rodava 24h/dia e um lote vencendo às 3h mandava
# "Encerramos nossa conversa" às 3h da manhã.
JANITOR_CLOSE_START="7"
JANITOR_CLOSE_END="19"
# Espaçamento entre avisos de fechamento do mesmo lote (ms) — evita rajada
JANITOR_CLOSE_SPACING_MIN_MS="3000"
JANITOR_CLOSE_SPACING_MAX_MS="8000"

# --- Anti-bloqueio: follow-up ---
# Espaçamento entre os envios de um mesmo tick (o tick pega até 5 por vez)
FOLLOWUP_SPACING_MIN_MS="8000"
FOLLOWUP_SPACING_MAX_MS="20000"

# --- Conector HiperTMS ---
# Preencher quando o Uelder validar
TMS_API_BASE_URL=""
TMS_SERVICE_TOKEN=""

# --- Asaas (billing) ---
ASAAS_WEBHOOK_TOKEN="SEU_TOKEN_ASAAS"

# --- URL pública para links de anexo (PDF) — VISÍVEL PRO LEAD ---
# Este é o domínio que aparece no link do material enviado por WhatsApp/e-mail.
# Use um subdomínio NEUTRO/da marca (NÃO "nexa"), apontando pro mesmo backend
# que serve /uploads/. Tem prioridade sobre NEXA_PUBLIC_URL.
# Local/piloto: URL do túnel (ngrok, cloudflare). Produção: domínio de material.
MEDIA_PUBLIC_BASE="https://material.hipertms.com.br"

# --- Ambiente ---
NODE_ENV="development"
PORT="3001"

# --- Portal do cliente (suporte web) ---
# Segredo proprio da sessao do portal (DIFERENTE do JWT_SECRET interno). Gerar forte no deploy.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PORTAL_JWT_SECRET=GERE_UM_SEGREDO_FORTE_AQUI

# ID do tenant do Nexa que recebe os chamados do portal TMS.
# Consultar: SELECT id FROM tenants; (geralmente 'default' em single-tenant)
NEXA_DEFAULT_TENANT_ID=default

# --- HiperTMS API (server-to-server: Nexa -> TMS) ---
# TMS_BASE_URL inclui o prefixo /api (ex: https://hipertms.com.br/api)
TMS_BASE_URL=http://localhost:3000/api
TMS_SERVICE_TOKEN=SEGREDO_COMPARTILHADO_TMS_NEXA

# F9 — sync do resumo do ticket de suporte pro TMS (Nexa -> TMS, sentido
# inverso do TMS_SERVICE_TOKEN acima — segredo SEPARADO de propósito, um
# vazamento não compromete o outro). Gerar com: openssl rand -hex 32
# Ver docs/features/tms-native-support/especificacao-sync-ticket-tms.md
NEXA_TICKET_WEBHOOK_SECRET=SEGREDO_SYNC_TICKET_NEXA_TMS

# --- Suporte humano (P2) ---
# E-mail que recebe aviso quando um chamado entra na fila humana
# (aberto pelo cliente no portal ou escalado pela Lia). Vazio = não envia.
SUPPORT_EMAIL=

# --- Monitor / Alertas em escala (A3-A5) ---
# Habilita reconciliação automática (pull TMS→Nexa a cada intervalo).
# Sem esta variável = setInterval nunca é registrado = reconciliação desativada.
MONITOR_ENABLED=true
# Intervalo entre reconciliações em minutos (default 60). Mínimo efetivo: 1.
MONITOR_SYNC_INTERVAL_MIN=60
# Provedor WhatsApp dos alertas: waha (default) | cloud (API oficial Meta)
MONITOR_WA_PROVIDER=waha
# STANDBY (2026-07-20, ver docs/STANDBY.md): alerta imediato fora do ciclo.
# Desligado por padrão — só o digest agendado envia (e nesse caso o digest
# INCLUI CRITICAL; com "true" o imediato assume o CRITICAL e o digest o exclui).
MONITOR_IMMEDIATE_ALERTS=false
# Throttle por severidade do digest WHATSAPP (2026-07-20, ADR 036 — e-mail
# recebe tudo, sem throttle). Dias entre inclusões por contato:
DIGEST_THROTTLE_DUE_SOON_DAYS=7
DIGEST_THROTTLE_INFO_DAYS=28

# --- WhatsApp do suporte humano (2026-07-20) ---
# Se preenchido, chamado escalado (support.escalated) também avisa este número
# por WhatsApp com deep link do Inbox (além do e-mail). Tratado como número
# interno pelo gate (resposta não vira lead). Vazio → só e-mail.
SUPPORT_WHATSAPP=""

# --- Whitelist de TESTE do gate de números internos (2026-07-20) ---
# Telefones (separados por vírgula) que passam pelo gate mesmo sendo internos
# (vendedor/contato de alerta) — para o time testar a Lia do próprio celular.
# Furo PROPOSITAL no gate: manter curto e limpar quando o teste acabar.
GATE_TEST_PHONES=""

# --- Painel do TMS (destino dos links por setor do digest, 2026-07-21) ---
# Base das páginas-hub por área (/fiscal, /logistic, /fleet, /finance,
# /procurement). Sem contrato novo: o mapa setor→página vive no Nexa.
TMS_PANEL_BASE_URL="https://hipertms.com.br"

# --- URL pública do PAINEL Nexa (frontend) — ADR 034 ---
# Usada no deep link das notificações de handoff pro vendedor
# ("Atender agora: <url>/inbox?c=<conversa>"). Vazia → notificação sem link.
# Local: http://localhost:5174 · Produção: URL do frontend (porta 8081/domínio).
NEXA_APP_URL=""
# Cloud API (só com MONITOR_WA_PROVIDER=cloud): exige template aprovado na Meta
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=
WA_CLOUD_TEMPLATE_DIGEST=
# Fila de despacho: teto de envios/minuto e tentativas com backoff (30s/2min/10min)
DISPATCH_MAX_PER_MINUTE=30
DISPATCH_MAX_ATTEMPTS=3
# Retenção do log de notificações (dias)
NOTIFICATION_LOG_RETENTION_DAYS=90

# --- Termômetro de gargalos de escala (2026-07-21) ---
# Verificador horário: avisa o ALERT_ADMIN_PHONE no WhatsApp quando um gargalo
# entra no AMARELO (1x/dia por métrica). Só leitura + aviso. Endpoint sob
# demanda: GET /api/health/scale. Ver docs/infra/monitoramento-gargalos-2026-07.md.
SCALE_WATCH_ENABLED=true
# Conexões do banco ≥ N% do max_connections → amarelo
SCALE_DB_WARN_PCT=70
# Fila de dispatch ≥ N jobs → amarelo
SCALE_QUEUE_WARN=50
# Alertas/hora → amarelo (vazio = auto: 70% de DISPATCH_MAX_PER_MINUTE×60)
SCALE_ALERTS_HOUR_WARN=

# --- Alertas de DEV (2026-07-22): 4 falhas silenciosas → seu WhatsApp+e-mail ---
# Verificador horário (DevWatchService): TMS parou de empurrar, Lia lenta,
# queries lentas acumulando, cron parado. 1x/dia por sinal. Mesmos canais
# (ALERT_ADMIN_PHONE/EMAIL). Os warns de log continuam iguais.
DEV_WATCH_ENABLED=true
# Nº de queries lentas/hora que dispara alerta
DEV_SLOW_QUERY_WARN=20
# p95 da Lia (ms) acima do qual alerta (já usado pelo log MON-009)
LIA_LATENCY_WARN_MS=15000
# Orçamento diário da Anthropic (US$). Gasto do dia ≥ isso → alerta de dev.
# 0/vazio = sem alerta de orçamento. Endpoint sob demanda: GET /api/health/ai-cost.
# Preços por Mtoken em AI_PRICE_IN / AI_PRICE_OUT (default 1 / 5).
AI_BUDGET_DAILY_USD=0
# Canais do admin da plataforma — recebem avisos de FALHA nos DOIS meios:
# saúde do WAHA (cai/volta), gargalos de escala, etc. (AdminAlertService).
# WhatsApp: número com DDI (ex: 5511917747429). E-mail: endereço.
ALERT_ADMIN_PHONE=
ALERT_ADMIN_EMAIL=
# SMTP do e-mail de alerta (fallback quando não há canal de e-mail salvo no banco)
EMAIL_SMTP_HOST=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_FROM_NAME=Nexa Monitor

# --- Disparo de campanha ---------------------------------------------------
# Reenvio TOTAL: libera o botao "Reenviar para todos" na tela de Disparo, que
# recoloca na fila TODOS os alvos da campanha — inclusive quem JA recebeu.
# Ferramenta de TESTE de entregabilidade. Deixe VAZIO/ausente em producao:
# repetir a mesma mensagem para a mesma pessoa e um dos sinais mais fortes de
# spam e derruba a entrega do dominio. Exclusoes deliberadas (opt-out,
# blocklist, concorrente, cliente TMS) continuam de fora mesmo com isto ligado.
CAMPAIGN_RESEND_ALL_ENABLED=

# Janela do dedup ENTRE campanhas, em dias. Quem recebeu um envio dentro da janela
# entra na campanha nova como skipped/ja_enviado; antes disso, pode receber de novo.
#
# VAZIO = comportamento atual: quem recebeu UMA vez nunca mais recebe. Seguro, mas
# impede cadencia de follow-up (o segundo toque, onde a maior parte das respostas
# aparece em prospeccao).
#
# ATENCAO ao ligar: a primeira campanha depois disso libera de uma vez toda a base
# contactada antes do corte. Confira quantos alvos isso significa ANTES de disparar —
# envio em massa nao tem desfazer. Sugestao de valor: 45 a 60.
CAMPAIGN_DEDUP_DAYS=
