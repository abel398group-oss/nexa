# ===== Nexa — variáveis de ambiente =====
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env real — ele está no .gitignore

# --- Banco ---
DATABASE_URL="postgresql://nexa:SENHA@127.0.0.1:5433/nexa?schema=public&connection_limit=20&pool_timeout=10"
TZ=America/Sao_Paulo

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT="6380"
REDIS_PASSWORD="SENHA_REDIS"

# --- IA (Anthropic) ---
# Gere uma nova key em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-api03-..."

# --- Auth ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="GERE_UM_SEGREDO_FORTE_AQUI"
JWT_REFRESH_SECRET="GERE_OUTRO_SEGREDO_FORTE_AQUI"

# --- Kill switch IA (ADR 012) ---
# "true" = Lia responde automaticamente | "false" = somente inbox manual
AI_AUTONOMY_ENABLED="true"

# --- CORS ---
# Em produção: coloque o domínio real separado por vírgula
# Ex: https://app.meudominio.com,https://admin.meudominio.com
CORS_ORIGINS="http://localhost:5173"

# --- Web Chat embutido (ADR 027) ---
# Origins permitidas para conexão WebSocket do widget LiaChat no HiperTMS.
# Em produção: domínio(s) do TMS separados por vírgula.
# Em desenvolvimento: qualquer origem é aceita (NODE_ENV != production).
# Ex: https://app.hipertms.com.br,https://staging.hipertms.com.br
WEBCHAT_ALLOWED_ORIGINS="http://localhost:5173"

# --- Webhook WAHA (OBRIGATÓRIO) ---
# Token secreto usado para autenticar o webhook do WAHA
# Configure o mesmo valor na URL do webhook no painel WAHA: ?token=SEU_TOKEN
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WAHA_WEBHOOK_TOKEN="GERE_UM_TOKEN_SECRETO_AQUI"

# --- WAHA (gateway WhatsApp) ---
WAHA_API_URL="http://localhost:3018"
WAHA_API_KEY="SUA_API_KEY_WAHA"
WAHA_SESSION="default"
# Lista de números permitidos para envio real (vazio = envia para todos)
# Ex: 5511999999999,5511888888888
WAHA_SEND_ALLOWLIST=""

# --- Conector HiperTMS ---
# Preencher quando o Uelder validar
TMS_API_BASE_URL=""
TMS_SERVICE_TOKEN=""

# --- Asaas (billing) ---
ASAAS_WEBHOOK_TOKEN="SEU_TOKEN_ASAAS"

# --- URL pública para links de anexo (PDF) — VISÍVEL PRO LEAD ---
# Este é o domínio que aparece no link do material enviado por WhatsApp/e-mail.
# Use um subdomínio NEUTRO/da marca (NÃO "nexa"), apontando pro mesmo backend
# que serve /uploads/. Tem prioridade sobre NEXA_PUBLIC_URL.
# Local/piloto: URL do túnel (ngrok, cloudflare). Produção: domínio de material.
MEDIA_PUBLIC_BASE="https://material.hipertms.com.br"

# --- Ambiente ---
NODE_ENV="development"
PORT="3001"

# --- Portal do cliente (suporte web) ---
# Segredo proprio da sessao do portal (DIFERENTE do JWT_SECRET interno). Gerar forte no deploy.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PORTAL_JWT_SECRET=GERE_UM_SEGREDO_FORTE_AQUI

# ID do tenant do Nexa que recebe os chamados do portal TMS.
# Consultar: SELECT id FROM tenants; (geralmente 'default' em single-tenant)
NEXA_DEFAULT_TENANT_ID=default

# --- HiperTMS API (server-to-server: Nexa -> TMS) ---
# TMS_BASE_URL inclui o prefixo /api (ex: https://app.hipertms.com.br/api)
TMS_BASE_URL=http://localhost:3000/api
TMS_SERVICE_TOKEN=SEGREDO_COMPARTILHADO_TMS_NEXA

# --- Suporte humano (P2) ---
# E-mail que recebe aviso quando um chamado entra na fila humana
# (aberto pelo cliente no portal ou escalado pela Lia). Vazio = não envia.
SUPPORT_EMAIL=

# --- Monitor / Alertas em escala (A3-A5) ---
# Habilita reconciliação automática (pull TMS→Nexa a cada intervalo).
# Sem esta variável = setInterval nunca é registrado = reconciliação desativada.
MONITOR_ENABLED=true
# Intervalo entre reconciliações em minutos (default 60). Mínimo efetivo: 1.
MONITOR_SYNC_INTERVAL_MIN=60
# Provedor WhatsApp dos alertas: waha (default) | cloud (API oficial Meta)
MONITOR_WA_PROVIDER=waha
# STANDBY (2026-07-20, ver docs/STANDBY.md): alerta imediato fora do ciclo.
# Desligado por padrão — só o digest agendado envia. "true" reativa.
MONITOR_IMMEDIATE_ALERTS=false
# Cloud API (só com MONITOR_WA_PROVIDER=cloud): exige template aprovado na Meta
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=
WA_CLOUD_TEMPLATE_DIGEST=
# Fila de despacho: teto de envios/minuto e tentativas com backoff (30s/2min/10min)
DISPATCH_MAX_PER_MINUTE=30
DISPATCH_MAX_ATTEMPTS=3
# Retenção do log de notificações (dias)
NOTIFICATION_LOG_RETENTION_DAYS=90
