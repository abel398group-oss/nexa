{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "Nexa Backend (NestJS + Prisma)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/guard-remote-db.mjs && prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:int:setup": "node scripts/setup-test-db.mjs",
    "eval": "vitest run --config vitest.eval.config.ts",
    "generate:kb": "node scripts/generate-manuais-kb.mjs \"../../hipertms_v12/docs/manuais tecnicos\" src/application/connectors/hipertms-manuais.data.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^2.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.3.0",
    "@prisma/client": "^5.0.0",
    "@xenova/transformers": "^2.17.2",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.2.0",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.9.9",
    "multer": "^2.1.1",
    "nestjs-pino": "^4.0.0",
    "nodemailer": "^8.0.11",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.0",
    "pino-http": "^10.0.0",
    "pino-pretty": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^5.4.0",
    "socket.io": "^4.7.0",
    "uuid": "^11.1.1",
    "@sentry/node": "^8.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/express": "^4.17.0",
    "@types/imap-simple": "^4.2.10",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/pg": "^8.20.0",
    "prisma": "^5.0.0",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
