# ===== Nexa — variáveis de ambiente (copie para .env e preencha) =====
# NUNCA commitar o .env real

# --- Banco ---
DATABASE_URL="postgresql://nexa:nexa_local_dev@localhost:5434/nexa?schema=public"

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT="6380"
REDIS_PASSWORD="nexa_redis_local_dev"

# --- IA (Anthropic) ---
ANTHROPIC_API_KEY="sk-ant-xxxxx"   # gerar key própria; nunca reusar a do MVP

# --- Auth ---
JWT_SECRET="trocar-por-chave-forte-aleatoria"
JWT_REFRESH_SECRET="trocar-por-outra-chave-forte"

# --- Kill switch (ADR 012) ---
AI_AUTONOMY_ENABLED="false"   # começa desligado; liga quando validar

# --- Conector HiperTMS (preencher quando o Uelder validar) ---
TMS_API_BASE_URL=""
TMS_SERVICE_TOKEN=""
