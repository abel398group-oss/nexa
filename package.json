{
  "name": "nexa",
  "version": "0.1.0",
  "private": true,
  "description": "Nexa — Plataforma de IA Comercial e Suporte para SaaS (Lia = a IA)",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter backend prisma:generate",
    "db:migrate": "pnpm --filter backend prisma:migrate",
    "db:studio": "pnpm --filter backend prisma:studio",
    "db:seed": "pnpm --filter backend prisma:seed",
    "lint": "eslint apps/backend/src",
    "test:frontend": "pnpm --filter frontend test",
    "test:backend": "pnpm --filter backend test",
    "typecheck": "pnpm --filter frontend typecheck",
    "test": "pnpm --filter backend test",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "test:e2e:ui": "pnpm --filter frontend test:e2e:ui",
    "test:e2e:full": "pnpm --filter frontend test:e2e",
    "test:e2e:visual": "pnpm --filter frontend test:e2e:visual"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.10.0"
  }
}
